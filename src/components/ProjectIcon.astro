---
/**
 * App-style project icon: a rounded tile with a multi-colour illustration
 * from src/data/icons.ts. Falls back to the title's first letter.
 */
import { icons } from '@/data/icons';

interface Props {
  icon?: string;
  title: string;
  accent: string;
  /** Rendered size in px. */
  size?: number;
  class?: string;
}

const { icon, title, accent, size = 56, class: className } = Astro.props;
const art = icon ? icons[icon] : undefined;
const bg = art?.bg ?? `linear-gradient(160deg, ${accent} 10%, color-mix(in oklab, ${accent} 45%, #0b0b10) 100%)`;
---

<span class:list={['icon', className]} style={`--c: ${accent}; --s: ${size}px; --bg: ${bg}`} aria-hidden="true">
  {
    art ? (
      <svg viewBox="0 0 64 64" set:html={art.art} />
    ) : (
      <span class="letter">{title.trim()[0]?.toUpperCase()}</span>
    )
  }
</span>

<style>
  .icon {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 27%;
    overflow: hidden;
    color: #fff;
    background: var(--bg);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.3),
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 calc(var(--s) * 0.18) calc(var(--s) * 0.5) calc(var(--s) * -0.2) color-mix(in oklab, var(--c) 70%, transparent);
  }

  /* Soft glass sheen across the top */
  .icon::after {
    content: '';
    position: absolute;
    inset: 0 0 55% 0;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.14), transparent);
    pointer-events: none;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .letter {
    font-size: calc(var(--s) * 0.46);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
</style>
