---
/**
 * App-style project icon: a glossy rounded tile in the project's accent
 * color with a white glyph. Falls back to the title's first letter.
 */
import { icons } from '@/data/icons';

interface Props {
  icon?: string;
  title: string;
  accent: string;
  /** Rendered size in px. */
  size?: number;
  class?: string;
}

const { icon, title, accent, size = 56, class: className } = Astro.props;
const glyph = icon ? icons[icon] : undefined;
---

<span class:list={['icon', className]} style={`--c: ${accent}; --s: ${size}px`} aria-hidden="true">
  {
    glyph ? (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={glyph}
      />
    ) : (
      <span class="letter">{title.trim()[0]?.toUpperCase()}</span>
    )
  }
</span>

<style>
  .icon {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 27%;
    color: #fff;
    background:
      radial-gradient(130% 110% at 20% 0%, color-mix(in oklab, var(--c) 55%, white) 0%, transparent 55%),
      linear-gradient(160deg, var(--c) 10%, color-mix(in oklab, var(--c) 45%, #0b0b10) 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      inset 0 -1px 0 rgb(0 0 0 / 0.25),
      0 calc(var(--s) * 0.18) calc(var(--s) * 0.5) calc(var(--s) * -0.2) color-mix(in oklab, var(--c) 75%, transparent);
  }

  /* Soft glass sheen across the top half */
  .icon::after {
    content: '';
    position: absolute;
    inset: 1px 1px 50% 1px;
    border-radius: inherit;
    border-bottom-left-radius: 40% 20%;
    border-bottom-right-radius: 40% 20%;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.22), transparent);
    pointer-events: none;
  }

  svg {
    width: 54%;
    height: 54%;
    filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.3));
  }

  .letter {
    font-size: calc(var(--s) * 0.46);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
</style>
