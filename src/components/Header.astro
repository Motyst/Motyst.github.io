---
import { profile } from '@/data/profile';

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Skills', href: '/#skills' },
  { label: 'About', href: '/#about' },
];
---

<header class="header" transition:persist>
  <div class="container inner">
    <a href="/" class="brand" aria-label="Home">
      <span class="dot" aria-hidden="true"></span>
      {profile.name}
    </a>
    <nav aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={`mailto:${profile.email}`} class="contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: rgb(9 9 11 / 0.65);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px var(--accent);
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 2rem);
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  nav a {
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--text);
  }

  .contact {
    color: var(--text);
    padding: 0.4em 0.95em;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }

  @media (max-width: 520px) {
    nav a:not(.contact):nth-child(3) {
      display: none;
    }
  }
</style>
