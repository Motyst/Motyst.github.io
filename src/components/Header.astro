---
/**
 * Floating pill navigation. Section links only: GitHub and email live in
 * the hero so they appear in one place. Hides while scrolling down and
 * comes back on scroll up.
 */
import { profile } from '@/data/profile';

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Skills', href: '/#skills' },
  { label: 'About', href: '/#about' },
];
const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header class="header" transition:persist>
  <nav class="pill" aria-label="Main">
    <a href="/" class="av" aria-label="Home" title={profile.name}>{initials}</a>
    {nav.map((item) => <a href={item.href} data-section={item.href.split('#')[1]}>{item.label}</a>)}
    <button type="button" class="theme" data-theme-toggle aria-label="Switch between light and dark">
      <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
      <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
    </button>
  </nav>
</header>

<script>
  // One listener for the whole visit (the header persists across navigations).
  const header = document.querySelector<HTMLElement>('.header');
  if (header && !header.dataset.ready) {
    header.dataset.ready = '1';
    let last = scrollY;
    // A jump from one of the bar's own links scrolls down too: keep the bar in view
    // until that scroll has been still for a moment
    let holding = false;
    let settle = 0;
    const holdOn = (ms: number) => {
      clearTimeout(settle);
      settle = window.setTimeout(() => (holding = false), ms);
    };
    header.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('a')) return;
      holding = true;
      header.classList.remove('away');
      holdOn(600);
    });
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        if (holding) {
          last = y;
          holdOn(250);
          return;
        }
        if (Math.abs(y - last) < 6) return;
        header.classList.toggle('away', y > last && y > 120);
        last = y;
      },
      { passive: true },
    );
    header.addEventListener('focusin', () => header.classList.remove('away'));

    // Light / dark switch: remembers the choice (see the theme script in Base.astro)
    const toggle = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
    const label = () => {
      const light = document.documentElement.dataset.theme === 'light';
      toggle.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
      toggle.title = light ? 'Dark mode' : 'Light mode';
    };
    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      label();
    });
    label();
    document.addEventListener('astro:after-swap', label);
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', label);
  }

  // Light up the link of the section currently in the middle of the screen.
  let spy: IntersectionObserver | undefined;
  document.addEventListener('astro:page-load', () => {
    spy?.disconnect();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.pill [data-section]')];
    const mark = (id: string | null) => links.forEach((a) => a.classList.toggle('on', a.dataset.section === id));
    mark(null);
    const sections = links.map((a) => document.getElementById(a.dataset.section!)).filter(Boolean) as HTMLElement[];
    if (!sections.length) return;
    const visible = new Set<string>();
    spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        mark(sections.find((s) => visible.has(s.id))?.id ?? null);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy!.observe(s));
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-top: 0.85rem;
    pointer-events: none;
    transition: translate 0.35s var(--ease);
  }
  .header.away {
    translate: 0 -120%;
  }

  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 12px 32px -16px var(--shadow);
    font-size: 0.88rem;
  }

  .pill a {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    color: var(--text-dim);
    transition:
      color 0.2s,
      background 0.2s;
  }
  .pill a:hover {
    color: var(--text);
    background: var(--hover);
  }
  .pill a.on {
    color: var(--text);
    background: var(--hover-strong);
  }

  .pill .av {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    margin-right: 0.2rem;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  /* Sun in dark mode (switch to light), moon in light mode */
  .theme {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-left: 0.1rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--text-dim);
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .theme:hover {
    color: var(--text);
    background: var(--hover);
  }
  .theme svg {
    grid-area: 1 / 1;
  }
  .moon,
  :global(html[data-theme='light']) .sun {
    display: none;
  }
  :global(html[data-theme='light']) .moon {
    display: block;
  }

  .pill .av:hover {
    background: var(--heading);
    color: var(--bg);
  }
</style>
