---
/**
 * Floating pill navigation. Section links only: GitHub and email live in
 * the hero so they appear in one place. Hides while scrolling down and
 * comes back on scroll up.
 */
import { profile } from '@/data/profile';

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Skills', href: '/#skills' },
  { label: 'About', href: '/#about' },
];
const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header class="header" transition:persist>
  <nav class="pill" aria-label="Main">
    <a href="/" class="av" aria-label="Home" title={profile.name}>{initials}</a>
    {nav.map((item) => <a href={item.href} data-section={item.href.split('#')[1]}>{item.label}</a>)}
  </nav>
</header>

<script>
  // One listener for the whole visit (the header persists across navigations).
  const header = document.querySelector<HTMLElement>('.header');
  if (header && !header.dataset.ready) {
    header.dataset.ready = '1';
    let last = scrollY;
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        if (Math.abs(y - last) < 6) return;
        header.classList.toggle('away', y > last && y > 120);
        last = y;
      },
      { passive: true },
    );
    header.addEventListener('focusin', () => header.classList.remove('away'));
  }

  // Light up the link of the section currently in the middle of the screen.
  let spy: IntersectionObserver | undefined;
  document.addEventListener('astro:page-load', () => {
    spy?.disconnect();
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.pill [data-section]')];
    const mark = (id: string | null) => links.forEach((a) => a.classList.toggle('on', a.dataset.section === id));
    mark(null);
    const sections = links.map((a) => document.getElementById(a.dataset.section!)).filter(Boolean) as HTMLElement[];
    if (!sections.length) return;
    const visible = new Set<string>();
    spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        mark(sections.find((s) => visible.has(s.id))?.id ?? null);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy!.observe(s));
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-top: 0.85rem;
    pointer-events: none;
    transition: translate 0.35s var(--ease);
  }
  .header.away {
    translate: 0 -120%;
  }

  .pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(23 23 27 / 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 12px 32px -16px rgb(0 0 0 / 0.8);
    font-size: 0.88rem;
  }

  .pill a {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    color: var(--text-dim);
    transition:
      color 0.2s,
      background 0.2s;
  }
  .pill a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }
  .pill a.on {
    color: var(--text);
    background: rgb(255 255 255 / 0.1);
  }

  .pill .av {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    margin-right: 0.2rem;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .pill .av:hover {
    background: #fff;
    color: var(--bg);
  }
</style>
