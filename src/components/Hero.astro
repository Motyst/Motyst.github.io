---
import ProjectIcon from './ProjectIcon.astro';
import Icon from './Icon.astro';
import { profile } from '@/data/profile';
import type { Project } from '@/lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const [first, ...rest] = profile.name.split(' ');
const city = profile.location.split(',')[0];
// Loose, hand-placed positions for the floating icon cluster (in %).
const spots = [
  { x: 14, y: 10, s: 92 },
  { x: 52, y: 0, s: 76 },
  { x: 40, y: 38, s: 108 },
  { x: 4, y: 58, s: 72 },
  { x: 74, y: 46, s: 84 },
  { x: 76, y: 8, s: 56 },
  { x: 24, y: 86, s: 56 },
  { x: 62, y: 86, s: 52 },
];
---

<section class="hero container">
  <div class="text">
    {
      profile.availability && (
        <span class="pill reveal">
          <i /> {profile.availability}
        </span>
      )
    }
    {/* Lab round 12 (typography): corner labels, statement headline and card corners, hidden unless a variant shows them */}
    <p class="meta meta-name reveal">
      <span>{profile.role} /<br />{profile.location}</span>
      <span class="plus">+{projects.length} projects</span>
    </p>
    <p class="meta meta-statement reveal">
      <span>{profile.name} /<br />{profile.role}</span>
      <span class="plus">+{city}</span>
    </p>
    <p class="statement reveal" style="--delay: 60ms">{profile.headline}</p>
    <h1 class="reveal"><span class="w">{first}</span> {rest.join(' ')}<span class="accent">.</span></h1>
    <p class="role reveal" style="--delay: 60ms">
      <span class="grad">{profile.role}</span> <span class="city">· {city}</span>
    </p>
    <p class="lead reveal" style="--delay: 120ms">{profile.headline}</p>
    <div class="actions reveal" style="--delay: 180ms">
      <div class="mailchip">
        <a href={`mailto:${profile.email}`} class="mail-go">
          <Icon name="mail" size={16} /> Email me
        </a>
        <button type="button" class="cp" data-copy-email={profile.email} title="Copy email address" aria-label="Copy email address">
          <Icon name="copy" size={14} class="i-copy" />
          <Icon name="check" size={14} class="i-done" />
        </button>
        <span class="toast" role="status"></span>
      </div>
      {
        profile.socials.map((s) => (
          <a href={s.url} class="round" target="_blank" rel="noopener noreferrer" title={s.label} aria-label={s.label}>
            <Icon name={s.label.toLowerCase()} size={19} />
          </a>
        ))
      }
      {
        profile.resume && (
          <a href={profile.resume} class="btn" target="_blank" rel="noopener">
            Résumé <span class="arrow">↗</span>
          </a>
        )
      }
    </div>
    <div class="corners">
      <a href="#work" class="go" aria-label="See my work"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg></a>
      <svg class="star" aria-hidden="true" viewBox="0 0 24 24" width="30" height="30" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"><path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7" /></svg>
    </div>
  </div>
  <div class="streaks" aria-hidden="true"></div>

  <div class="cluster reveal" style="--delay: 200ms">
    {
      projects.slice(0, spots.length).map((p, i) => (
        <button
          type="button"
          class="float"
          data-open={p.id}
          style={`left: ${spots[i].x}%; top: ${spots[i].y}%; --i: ${i}`}
          aria-label={`Open ${p.data.title}`}
          title={p.data.title}
        >
          <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={spots[i].s} />
        </button>
      ))
    }
  </div>
</section>

<script>
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Fallback for non-https previews
      const t = document.createElement('textarea');
      t.value = text;
      t.style.position = 'fixed';
      t.style.opacity = '0';
      document.body.append(t);
      t.select();
      document.execCommand('copy');
      t.remove();
    }
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((b) => {
      const chip = b.parentElement!;
      const toast = chip.querySelector<HTMLElement>('.toast')!;
      let timer = 0;
      b.addEventListener('click', async () => {
        await copy(b.dataset.copyEmail!);
        chip.classList.add('copied');
        toast.textContent = 'Email copied';
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          chip.classList.remove('copied');
          toast.textContent = '';
        }, 1800);
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.25fr 1fr;
    }
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .pill i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
  }

  /* Role as a gradient subtitle under the name */
  .role {
    margin-top: 0.7rem;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .grad {
    background: linear-gradient(90deg, #a78bfa, #4cc9f0 55%, #fb7185);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .city {
    color: var(--text-faint);
    font-weight: 500;
  }

  h1 {
    margin-top: 0;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
    font-weight: 650;
  }
  /* The dot slowly cycles through the project colours */
  .accent {
    color: var(--accent);
    animation: dot-hue 10s linear infinite;
  }
  @keyframes dot-hue {
    0%,
    100% {
      color: #a78bfa;
    }
    20% {
      color: #4cc9f0;
    }
    40% {
      color: #14b8a6;
    }
    60% {
      color: #fb7185;
    }
    80% {
      color: #3b82f6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .accent {
      animation: none;
    }
  }

  .lead {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--text-dim);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Email: the text opens the mail app, the icon copies the address */
  .mailchip {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.02);
    font-size: 0.92rem;
    transition: border-color 0.2s;
  }
  .mailchip:hover {
    border-color: rgb(255 255 255 / 0.3);
  }
  .mail-go {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem 0.4rem 0.75rem;
    margin-right: 0.3rem;
    border-radius: 999px;
    transition: background 0.2s;
  }
  .mail-go :global(svg) {
    color: var(--text-dim);
  }
  .mail-go:hover {
    background: rgb(255 255 255 / 0.06);
  }
  .cp {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--bg-soft);
    color: var(--text-dim);
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .cp:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.1);
  }
  .cp :global(svg) {
    grid-area: 1 / 1;
  }
  .cp :global(.i-done),
  .copied .cp :global(.i-copy) {
    display: none;
  }
  .copied .cp :global(.i-done) {
    display: block;
  }
  .mailchip.copied {
    border-color: rgb(34 197 94 / 0.5);
  }
  .copied .cp,
  .copied .cp:hover {
    background: #16a34a;
    color: #fff;
  }
  .toast {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    translate: -50% 4px;
    padding: 0.2rem 0.6rem;
    border-radius: 8px;
    background: #16a34a;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s,
      translate 0.2s var(--ease);
  }
  .copied .toast {
    opacity: 1;
    translate: -50% 0;
  }

  .round {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text-dim);
    transition:
      color 0.2s,
      border-color 0.2s,
      transform 0.2s var(--ease);
  }
  .round:hover {
    color: var(--text);
    border-color: rgb(255 255 255 / 0.3);
    transform: translateY(-1px);
  }

  /* Floating project icons */
  .cluster {
    position: relative;
    height: clamp(220px, 28vw, 340px);
  }
  .cluster::before {
    content: '';
    position: absolute;
    inset: 10% 5%;
    background: radial-gradient(closest-side, rgb(124 156 255 / 0.16), transparent);
    filter: blur(10px);
  }
  .float {
    position: absolute;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    animation: bob 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.3s);
  }
  .float :global(.icon) {
    transition: transform 0.35s var(--ease);
  }
  .float:hover :global(.icon),
  .float:focus-visible :global(.icon) {
    transform: scale(1.1) rotate(-4deg);
  }
  @keyframes bob {
    50% {
      translate: 0 -10px;
    }
  }

  /* ---------- Design lab round 12: typography from the glass card reference ---------- */
  .meta,
  .statement,
  .corners,
  .streaks {
    display: none;
  }
  .w {
    display: inline;
  }

  /* Shared rules: plain white type, no gradient, small two-line corner labels,
     a lighter subtitle close under the headline */
  :global(html[data-lab^='type-']) .meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
    font-size: 0.85rem;
    line-height: 1.3;
    color: rgb(255 255 255 / 0.78);
    letter-spacing: -0.005em;
  }
  :global(html[data-lab^='type-']) .plus {
    color: #fff;
    font-weight: 500;
  }
  :global(html[data-lab^='type-']) h1 {
    color: #fff;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  :global(html[data-lab^='type-']) .accent {
    color: #fff;
    animation: none;
  }
  :global(html[data-lab^='type-']) .role {
    display: none;
  }
  :global(html[data-lab^='type-']) .lead {
    margin-top: 1.25rem;
    max-width: 30ch;
    font-size: clamp(1.15rem, 1.9vw, 1.4rem);
    line-height: 1.35;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.86);
  }
  :global(html[data-lab^='type-']) .actions {
    margin-top: 2.25rem;
  }

  /* A: the name as the headline, in two lines, role and city as the corner label */
  :global(html[data-lab='type-a']) .meta-statement,
  :global(html[data-lab='type-c']) .meta-statement {
    display: none;
  }
  :global(html[data-lab='type-a']) .w,
  :global(html[data-lab='type-c']) .w {
    display: block;
  }
  :global(html[data-lab='type-a']) h1,
  :global(html[data-lab='type-c']) h1 {
    font-size: clamp(3rem, 7.5vw, 5.75rem);
  }

  /* B: the headline is a statement, the name moves to the corner label */
  :global(html[data-lab='type-b']) .meta-name,
  :global(html[data-lab='type-b']) h1,
  :global(html[data-lab='type-b']) .lead {
    display: none;
  }
  :global(html[data-lab='type-b']) .statement {
    display: block;
    max-width: 17ch;
    font-size: clamp(2.3rem, 4.9vw, 3.9rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    color: #fff;
  }

  /* C: A's type on a frosted glass card over soft streaks of project colour,
     with an arrow and an asterisk in the bottom corners */
  :global(html[data-lab='type-c']) .text {
    position: relative;
    z-index: 1;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: 28px;
    border: 1px solid rgb(255 255 255 / 0.13);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.015) 60%);
    backdrop-filter: blur(28px) saturate(1.3);
    -webkit-backdrop-filter: blur(28px) saturate(1.3);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 40px 80px -40px rgb(0 0 0 / 0.8);
  }
  :global(html[data-lab='type-c']) .corners {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    color: #fff;
  }
  :global(html[data-lab='type-c']) .go {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid #fff;
    border-radius: 50%;
  }
  :global(html[data-lab='type-c']) .streaks {
    display: block;
    position: absolute;
    inset: 4% 30% 0 -4%;
    pointer-events: none;
    background:
      radial-gradient(30% 14% at 55% 30%, rgb(249 115 22 / 0.55), transparent 70%),
      radial-gradient(26% 12% at 70% 72%, rgb(249 115 22 / 0.4), transparent 70%),
      radial-gradient(40% 60% at 85% 45%, rgb(45 212 191 / 0.22), transparent 70%),
      radial-gradient(45% 55% at 20% 60%, rgb(167 139 250 / 0.22), transparent 70%);
    filter: blur(20px);
    transform: rotate(-18deg);
  }

  @media (max-width: 899px) {
    .cluster {
      height: 170px;
      max-width: 420px;
    }
    .float {
      scale: 0.72;
      transform-origin: top left;
    }
  }
</style>
