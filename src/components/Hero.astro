---
import ProjectIcon from './ProjectIcon.astro';
import { profile } from '@/data/profile';
import type { Project } from '@/lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
// Loose, hand-placed positions for the floating icon cluster (in %).
const spots = [
  { x: 14, y: 10, s: 92 },
  { x: 52, y: 0, s: 76 },
  { x: 40, y: 38, s: 108 },
  { x: 4, y: 58, s: 72 },
  { x: 74, y: 46, s: 84 },
  { x: 76, y: 8, s: 56 },
  { x: 24, y: 86, s: 56 },
  { x: 62, y: 86, s: 52 },
];
---

<section class="hero container">
  <div class="text">
    {
      profile.availability && (
        <span class="pill reveal">
          <i /> {profile.availability}
        </span>
      )
    }
    <p class="eyebrow reveal">{profile.role} · {profile.location.split(',')[0]}</p>
    <h1 class="reveal" style="--delay: 60ms">{profile.name}<span class="accent">.</span></h1>
    <p class="lead reveal" style="--delay: 120ms">{profile.headline}</p>
    <div class="actions reveal" style="--delay: 180ms">
      <a href="#work" class="btn btn-primary">See my work <span class="arrow">↘</span></a>
      <a href={`mailto:${profile.email}`} class="btn">Get in touch</a>
      {
        profile.resume && (
          <a href={profile.resume} class="btn" target="_blank" rel="noopener">
            Résumé <span class="arrow">↗</span>
          </a>
        )
      }
    </div>
  </div>

  <div class="cluster reveal" style="--delay: 200ms">
    {
      projects.slice(0, spots.length).map((p, i) => (
        <button
          type="button"
          class="float"
          data-open={p.id}
          style={`left: ${spots[i].x}%; top: ${spots[i].y}%; --i: ${i}`}
          aria-label={`Open ${p.data.title}`}
          title={p.data.title}
        >
          <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={spots[i].s} />
        </button>
      ))
    }
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.25fr 1fr;
    }
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .pill i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
    font-weight: 650;
  }
  .accent {
    color: var(--accent);
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--text-dim);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Floating project icons */
  .cluster {
    position: relative;
    height: clamp(220px, 28vw, 340px);
  }
  .cluster::before {
    content: '';
    position: absolute;
    inset: 10% 5%;
    background: radial-gradient(closest-side, rgb(124 156 255 / 0.16), transparent);
    filter: blur(10px);
  }
  .float {
    position: absolute;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    animation: bob 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.3s);
  }
  .float :global(.icon) {
    transition: transform 0.35s var(--ease);
  }
  .float:hover :global(.icon),
  .float:focus-visible :global(.icon) {
    transform: scale(1.1) rotate(-4deg);
  }
  @keyframes bob {
    50% {
      translate: 0 -10px;
    }
  }

  @media (max-width: 899px) {
    .cluster {
      height: 170px;
      max-width: 420px;
    }
    .float {
      scale: 0.72;
      transform-origin: top left;
    }
  }
</style>
