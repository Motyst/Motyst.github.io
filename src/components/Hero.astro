---
import ProjectIcon from './ProjectIcon.astro';
import Icon from './Icon.astro';
import { profile } from '@/data/profile';
import type { Project } from '@/lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
// Loose, hand-placed positions for the floating icon cluster (in %).
const spots = [
  { x: 14, y: 10, s: 92 },
  { x: 52, y: 0, s: 76 },
  { x: 40, y: 38, s: 108 },
  { x: 4, y: 58, s: 72 },
  { x: 74, y: 46, s: 84 },
  { x: 76, y: 8, s: 56 },
  { x: 24, y: 86, s: 56 },
  { x: 62, y: 86, s: 52 },
];
---

<section class="hero container">
  <div class="text">
    {
      profile.availability && (
        <span class="pill reveal">
          <i /> {profile.availability}
        </span>
      )
    }
    <p class="eyebrow reveal">{profile.role} · {profile.location.split(',')[0]}</p>
    <h1 class="reveal" style="--delay: 60ms">{profile.name}<span class="accent">.</span></h1>
    <p class="lead reveal" style="--delay: 120ms">{profile.headline}</p>
    <div class="actions reveal" style="--delay: 180ms">
      <a href="#work" class="btn btn-primary">See my work <Icon name="arrow-down" size={16} /></a>
      <button type="button" class="mailchip" data-copy-email={profile.email} title="Copy email address">
        <Icon name="mail" size={16} />
        <span>{profile.email}</span>
        <span class="cp" aria-hidden="true">
          <Icon name="copy" size={14} class="i-copy" />
          <Icon name="check" size={14} class="i-done" />
        </span>
        <span class="toast" role="status"></span>
      </button>
      {
        profile.socials.map((s) => (
          <a href={s.url} class="round" target="_blank" rel="noopener noreferrer" title={s.label} aria-label={s.label}>
            <Icon name={s.label.toLowerCase()} size={19} />
          </a>
        ))
      }
      {
        profile.resume && (
          <a href={profile.resume} class="btn" target="_blank" rel="noopener">
            Résumé <span class="arrow">↗</span>
          </a>
        )
      }
    </div>
  </div>

  <div class="cluster reveal" style="--delay: 200ms">
    {
      projects.slice(0, spots.length).map((p, i) => (
        <button
          type="button"
          class="float"
          data-open={p.id}
          style={`left: ${spots[i].x}%; top: ${spots[i].y}%; --i: ${i}`}
          aria-label={`Open ${p.data.title}`}
          title={p.data.title}
        >
          <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={spots[i].s} />
        </button>
      ))
    }
  </div>
</section>

<script>
  async function copy(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Fallback for non-https previews
      const t = document.createElement('textarea');
      t.value = text;
      t.style.position = 'fixed';
      t.style.opacity = '0';
      document.body.append(t);
      t.select();
      document.execCommand('copy');
      t.remove();
    }
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((b) => {
      const toast = b.querySelector<HTMLElement>('.toast')!;
      let timer = 0;
      b.addEventListener('click', async () => {
        await copy(b.dataset.copyEmail!);
        b.classList.add('copied');
        toast.textContent = 'Copied';
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          b.classList.remove('copied');
          toast.textContent = '';
        }, 1800);
      });
    });
  });
</script>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.25fr 1fr;
    }
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .pill i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
    font-weight: 650;
  }
  .accent {
    color: var(--accent);
  }

  .lead {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    color: var(--text-dim);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Email chip: click copies the address */
  .mailchip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.45rem 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.02);
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    transition:
      border-color 0.2s,
      transform 0.2s var(--ease);
  }
  .mailchip:hover {
    border-color: rgb(255 255 255 / 0.3);
    transform: translateY(-1px);
  }
  .mailchip > :global(svg) {
    color: var(--text-dim);
  }
  .cp {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--bg-soft);
    color: var(--text-dim);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .cp :global(svg) {
    grid-area: 1 / 1;
  }
  .cp :global(.i-done),
  .copied .cp :global(.i-copy) {
    display: none;
  }
  .copied .cp :global(.i-done) {
    display: block;
  }
  .mailchip.copied {
    border-color: rgb(34 197 94 / 0.5);
  }
  .copied .cp {
    background: #16a34a;
    color: #fff;
  }
  .toast {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    translate: -50% 4px;
    padding: 0.2rem 0.6rem;
    border-radius: 8px;
    background: #16a34a;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s,
      translate 0.2s var(--ease);
  }
  .copied .toast {
    opacity: 1;
    translate: -50% 0;
  }

  .round {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text-dim);
    transition:
      color 0.2s,
      border-color 0.2s,
      transform 0.2s var(--ease);
  }
  .round:hover {
    color: var(--text);
    border-color: rgb(255 255 255 / 0.3);
    transform: translateY(-1px);
  }

  /* Floating project icons */
  .cluster {
    position: relative;
    height: clamp(220px, 28vw, 340px);
  }
  .cluster::before {
    content: '';
    position: absolute;
    inset: 10% 5%;
    background: radial-gradient(closest-side, rgb(124 156 255 / 0.16), transparent);
    filter: blur(10px);
  }
  .float {
    position: absolute;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    animation: bob 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.3s);
  }
  .float :global(.icon) {
    transition: transform 0.35s var(--ease);
  }
  .float:hover :global(.icon),
  .float:focus-visible :global(.icon) {
    transform: scale(1.1) rotate(-4deg);
  }
  @keyframes bob {
    50% {
      translate: 0 -10px;
    }
  }

  @media (max-width: 899px) {
    .cluster {
      height: 170px;
      max-width: 420px;
    }
    .float {
      scale: 0.72;
      transform-origin: top left;
    }
  }
</style>
