---
import Icon from './Icon.astro';
import { profile } from '@/data/profile';
import { aboutVariants } from '@/data/lab-variants';

interface Props {
  /** Design lab preview only (see src/data/lab-variants.ts). */
  variant?: string;
}

const lab = aboutVariants[Astro.props.variant as keyof typeof aboutVariants];
const principles = lab?.principles ?? profile.principles;
const quote = lab?.quote;

const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<section class="section" id="about">
  <div class="container layout reveal">
    <div class="head">
      <div class="photo">
        {profile.photo ? <img src={profile.photo} alt={profile.name} width="160" height="160" loading="lazy" /> : <span>{initials}</span>}
      </div>
      <div>
        <span class="eyebrow">About</span>
        <h2>A bit about me</h2>
      </div>
    </div>

    <div>
      <div class="bio">
        {profile.bio.map((p) => <p>{p}</p>)}
      </div>
      {quote && <blockquote class="quote">{quote}</blockquote>}
      <ul class:list={['principles', { grid: principles.length === 4 }]}>
        {
          principles.map((pr) => (
            <li style={`--p: ${pr.color}`}>
              <span class="pi">
                <Icon name={pr.icon} size={18} />
              </span>
              <span>
                <b>{pr.title}</b>
                <small>{pr.text}</small>
              </span>
            </li>
          ))
        }
      </ul>
      <dl class="facts">
        <div>
          <dt>Based in</dt>
          <dd>{profile.location}</dd>
        </div>
        {
          profile.languages.length > 0 && (
            <div>
              <dt>Speaks</dt>
              <dd>{profile.languages.map((l) => l.replace(/\s*\(.*\)/, '')).join(' · ')}</dd>
            </div>
          )
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 1.5rem 4rem;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1fr 1.6fr;
    }
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.25rem);
  }

  /* Photo (or initials until a photo is added) */
  .head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .photo {
    flex: none;
    width: clamp(88px, 12vw, 150px);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, #a78bfa, #4cc9f0 50%, #fb7185);
    box-shadow: 0 20px 50px -24px rgb(167 139 250 / 0.7);
  }
  .photo img,
  .photo span {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bg);
  }
  .photo span {
    display: grid;
    place-items: center;
    background: var(--bg-elev);
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.03em;
  }
  @media (max-width: 899px) {
    .head {
      flex-direction: row;
      align-items: center;
    }
  }

  /* A short statement */
  .quote {
    position: relative;
    margin: 1.75rem 0 0;
    padding: 0.2rem 0 0.2rem 1.25rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .quote::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 3px;
    background: linear-gradient(180deg, #a78bfa, #4cc9f0 55%, #fb7185);
  }

  /* How I work */
  .principles {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }
  @media (min-width: 640px) {
    .principles.grid {
      grid-template-columns: 1fr 1fr;
    }
    .principles.grid li {
      align-items: flex-start;
    }
  }
  .principles li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }
  .pi {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    color: var(--p);
    background: color-mix(in oklab, var(--p) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--p) 35%, transparent);
  }
  .principles b {
    display: block;
    font-weight: 600;
    font-size: 0.98rem;
  }
  .principles small {
    display: block;
    color: var(--text-dim);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .bio {
    display: grid;
    gap: 1rem;
    color: var(--text-dim);
    font-size: 1.1rem;
    max-width: 58ch;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin: 2rem 0 0;
  }
  dt {
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-bottom: 0.25rem;
  }
  dd {
    margin: 0;
  }
  dd a {
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.2s;
  }
  dd a:hover {
    border-color: var(--accent);
  }
</style>
