---
/**
 * The single project window. It holds one ProjectPanel per project and a
 * shared footer (previous / icon dock / next). Switching projects swaps
 * the visible panel with a slide, so the window itself never closes.
 *
 * Open it from anywhere with data-open="<project id>". ← and → switch
 * projects, Esc closes. The open project is kept in ?project=<id>.
 */
import ProjectPanel from './ProjectPanel.astro';
import ProjectIcon from './ProjectIcon.astro';
import type { Project } from '@/lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<dialog class="modal" id="project-dialog" aria-label="Project details">
  <div class="panels">
    {projects.map((p) => <ProjectPanel project={p} />)}
  </div>

  <footer class="foot">
    <button type="button" class="nav" data-step="-1" aria-label="Previous project">
      <span class="arr">←</span>
      {
        projects.map((p) => (
          <span class="lbl" data-for={p.id} hidden>
            <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={30} />
            <span class="nav-t">{p.data.title}</span>
          </span>
        ))
      }
    </button>

    <nav class="dock" aria-label="All projects">
      {
        projects.map((p) => (
          <button type="button" class="dock-i" data-open={p.id} title={p.data.title} aria-label={p.data.title}>
            <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={30} />
          </button>
        ))
      }
    </nav>

    <button type="button" class="nav next" data-step="1" aria-label="Next project">
      {
        projects.map((p) => (
          <span class="lbl" data-for={p.id} hidden>
            <span class="nav-t">{p.data.title}</span>
            <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={30} />
          </span>
        ))
      }
      <span class="arr">→</span>
    </button>
  </footer>
</dialog>

<script>
  function initProjectDialog() {
    const dialog = document.getElementById('project-dialog') as HTMLDialogElement | null;
    if (!dialog) return;
    const panels = [...dialog.querySelectorAll<HTMLElement>('[data-panel]')];
    const order = panels.map((p) => p.dataset.panel!);
    let current: string | null = null;

    const setParam = (id: string | null) => {
      const url = new URL(location.href);
      if (id) url.searchParams.set('project', id);
      else url.searchParams.delete('project');
      history.replaceState(history.state, '', url);
    };

    const neighbour = (id: string, d: number) => order[(order.indexOf(id) + d + order.length) % order.length];

    function show(id: string, dir: number) {
      for (const panel of panels) {
        const on = panel.dataset.panel === id;
        panel.classList.remove('in-left', 'in-right');
        if (!on) {
          panel.hidden = true;
          panel.querySelectorAll('video').forEach((v) => v.pause());
          continue;
        }
        panel.hidden = false;
        panel.querySelector('.scroll')?.scrollTo(0, 0);
        if (dir) {
          void panel.offsetWidth; // restart the animation
          panel.classList.add(dir > 0 ? 'in-right' : 'in-left');
        }
        (panel.querySelector('.scroll') as HTMLElement | null)?.focus({ preventScroll: true });
      }
      dialog!.querySelectorAll<HTMLElement>('.dock-i').forEach((b) => {
        const on = b.dataset.open === id;
        b.classList.toggle('on', on);
        if (on) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
      const prev = neighbour(id, -1);
      const next = neighbour(id, 1);
      dialog!.querySelectorAll<HTMLElement>('[data-step="-1"] .lbl').forEach((l) => (l.hidden = l.dataset.for !== prev));
      dialog!.querySelectorAll<HTMLElement>('[data-step="1"] .lbl').forEach((l) => (l.hidden = l.dataset.for !== next));
      current = id;
      setParam(id);
    }

    function open(id: string, dir?: number) {
      if (!order.includes(id)) return;
      if (!dialog!.open) {
        dialog!.showModal();
        document.documentElement.style.overflow = 'hidden';
        show(id, 0);
        return;
      }
      if (id === current) return;
      show(id, dir ?? Math.sign(order.indexOf(id) - order.indexOf(current!)));
    }

    const step = (d: number) => current && open(neighbour(current, d), d);

    document.querySelectorAll<HTMLElement>('[data-open]').forEach((el) =>
      el.addEventListener('click', () => open(el.dataset.open!)),
    );
    dialog.querySelectorAll<HTMLElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => step(Number(b.dataset.step))),
    );
    dialog.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));

    dialog.addEventListener('click', (e) => {
      // Click on the backdrop (outside the window) closes it.
      if (e.target === dialog) return dialog.close();
      // Links to another project inside a description switch panels instead.
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.prose a[href^="/work/"]');
      const id = link?.getAttribute('href')!.split('/')[2];
      if (id && order.includes(id)) {
        e.preventDefault();
        open(id);
      }
    });

    // ← / → switch projects (unless the user is typing or seeking a video).
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, video, [data-strip]')) return;
      e.preventDefault();
      step(e.key === 'ArrowRight' ? 1 : -1);
    });

    dialog.addEventListener('close', () => {
      dialog.querySelectorAll('video').forEach((v) => v.pause());
      document.documentElement.style.overflow = '';
      current = null;
      setParam(null);
    });

    // Media strips: arrows + counter
    dialog.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
      const box = strip.parentElement!;
      const count = box.querySelector<HTMLElement>('[data-strip-count]');
      const total = strip.children.length;
      box.querySelectorAll<HTMLButtonElement>('[data-strip-go]').forEach((b) =>
        b.addEventListener('click', () =>
          strip.scrollBy({ left: Number(b.dataset.stripGo) * strip.clientWidth, behavior: 'smooth' }),
        ),
      );
      strip.addEventListener('scroll', () => {
        if (count) count.textContent = `${Math.round(strip.scrollLeft / strip.clientWidth) + 1} / ${total}`;
      });
    });

    const initial = new URLSearchParams(location.search).get('project');
    if (initial) open(initial);
  }

  document.addEventListener('astro:page-load', initProjectDialog);
</script>

<style>
  .modal {
    width: min(920px, 100vw - 2rem);
    height: min(90vh, 900px);
    max-height: none;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    color: var(--text);
    overflow: hidden;
    box-shadow:
      0 40px 120px -30px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(255 255 255 / 0.02);
  }
  .modal[open] {
    display: flex;
    flex-direction: column;
    animation: pop 0.35s var(--ease);
  }
  .modal::backdrop {
    background: rgb(4 4 6 / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fade 0.3s ease;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .panels {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    background: var(--bg-elev);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.3rem 0.5rem 0.3rem 0.3rem;
    border: 0;
    border-radius: 12px;
    background: none;
    color: var(--text-dim);
    font: inherit;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .nav:hover {
    background: var(--bg-soft);
    color: var(--text);
  }
  .nav.next {
    grid-column: 3;
    justify-self: end;
    padding: 0.3rem 0.3rem 0.3rem 0.5rem;
  }
  .lbl {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .lbl[hidden] {
    display: none;
  }
  .nav-t {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .arr {
    color: var(--text-faint);
  }
  .dock {
    grid-column: 2;
    display: flex;
    gap: 0.35rem;
    padding: 0.3rem;
    border-radius: 14px;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .dock-i {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 9px;
    opacity: 0.5;
    transition:
      opacity 0.2s,
      transform 0.25s var(--ease);
  }
  .dock-i:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .dock-i.on {
    opacity: 1;
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  /* Phones: a full-height bottom sheet */
  @media (max-width: 640px) {
    .modal {
      width: 100vw;
      max-width: 100vw;
      height: 94dvh;
      margin: auto 0 0;
      border-radius: 20px 20px 0 0;
      border-bottom: 0;
    }
    .modal[open] {
      animation: slide 0.35s var(--ease);
    }
    .foot {
      padding-inline: 0.75rem;
      gap: 0.4rem;
    }
    .lbl {
      display: none !important;
    }
  }
  @keyframes slide {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
  }
</style>
