---
/**
 * The single project window. It holds one ProjectPanel per project and a
 * shared footer with every project's icon. Switching projects swaps
 * the visible panel with a slide, so the window itself never closes.
 *
 * Open it from anywhere with data-open="<project id>". ← and → switch
 * projects, Esc closes. The open project is kept in ?project=<id>.
 */
import ProjectPanel from './ProjectPanel.astro';
import ProjectIcon from './ProjectIcon.astro';
import type { Project } from '@/lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<dialog class="modal" id="project-dialog" aria-label="Project details">
  <div class="panels">
    {projects.map((p) => <ProjectPanel project={p} />)}
  </div>

  <footer class="foot">
    <nav class="dock" aria-label="All projects">
      {
        projects.map((p) => (
          <button type="button" class="dock-i" data-open={p.id} title={p.data.title} aria-label={p.data.title}>
            <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={36} />
          </button>
        ))
      }
    </nav>
  </footer>
</dialog>

<script>
  function initProjectDialog() {
    const dialog = document.getElementById('project-dialog') as HTMLDialogElement | null;
    if (!dialog) return;
    const panels = [...dialog.querySelectorAll<HTMLElement>('[data-panel]')];
    const order = panels.map((p) => p.dataset.panel!);
    let current: string | null = null;

    const setParam = (id: string | null) => {
      const url = new URL(location.href);
      if (id) url.searchParams.set('project', id);
      else url.searchParams.delete('project');
      history.replaceState(history.state, '', url);
    };

    const neighbour = (id: string, d: number) => order[(order.indexOf(id) + d + order.length) % order.length];

    function show(id: string, dir: number) {
      for (const panel of panels) {
        const on = panel.dataset.panel === id;
        panel.classList.remove('in-left', 'in-right');
        if (!on) {
          panel.hidden = true;
          panel.querySelectorAll('video').forEach((v) => v.pause());
          continue;
        }
        panel.hidden = false;
        panel.querySelector('.scroll')?.scrollTo(0, 0);
        if (dir) {
          void panel.offsetWidth; // restart the animation
          panel.classList.add(dir > 0 ? 'in-right' : 'in-left');
        }
        (panel.querySelector('.scroll') as HTMLElement | null)?.focus({ preventScroll: true });
      }
      dialog!.querySelectorAll<HTMLElement>('.dock-i').forEach((b) => {
        const on = b.dataset.open === id;
        b.classList.toggle('on', on);
        if (on) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
      current = id;
      setParam(id);
    }

    function open(id: string, dir?: number) {
      if (!order.includes(id)) return;
      if (!dialog!.open) {
        dialog!.showModal();
        document.documentElement.style.overflow = 'hidden';
        show(id, 0);
        return;
      }
      if (id === current) return;
      show(id, dir ?? Math.sign(order.indexOf(id) - order.indexOf(current!)));
    }

    const step = (d: number) => current && open(neighbour(current, d), d);

    document.querySelectorAll<HTMLElement>('[data-open]').forEach((el) =>
      el.addEventListener('click', () => open(el.dataset.open!)),
    );
    dialog.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));

    dialog.addEventListener('click', (e) => {
      // Click on the backdrop (outside the window) closes it.
      if (e.target === dialog) return dialog.close();
      // Links to another project inside a description switch panels instead.
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.prose a[href^="/work/"]');
      const id = link?.getAttribute('href')!.split('/')[2];
      if (id && order.includes(id)) {
        e.preventDefault();
        open(id);
      }
    });

    // ← / → switch projects (unless the user is typing or seeking a video).
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, video, [data-strip]')) return;
      e.preventDefault();
      step(e.key === 'ArrowRight' ? 1 : -1);
    });

    dialog.addEventListener('close', () => {
      dialog.querySelectorAll('video').forEach((v) => v.pause());
      document.documentElement.style.overflow = '';
      current = null;
      setParam(null);
    });

    // Media strips: arrows + counter
    dialog.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
      const box = strip.parentElement!;
      const count = box.querySelector<HTMLElement>('[data-strip-count]');
      const total = strip.children.length;
      box.querySelectorAll<HTMLButtonElement>('[data-strip-go]').forEach((b) =>
        b.addEventListener('click', () =>
          strip.scrollBy({ left: Number(b.dataset.stripGo) * strip.clientWidth, behavior: 'smooth' }),
        ),
      );
      strip.addEventListener('scroll', () => {
        if (count) count.textContent = `${Math.round(strip.scrollLeft / strip.clientWidth) + 1} / ${total}`;
      });
    });

    const initial = new URLSearchParams(location.search).get('project');
    if (initial) open(initial);
  }

  document.addEventListener('astro:page-load', initProjectDialog);
</script>

<style>
  .modal {
    width: min(920px, 100vw - 2rem);
    height: min(90vh, 900px);
    max-height: none;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    color: var(--text);
    overflow: hidden;
    box-shadow:
      0 40px 120px -30px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(255 255 255 / 0.02);
  }
  .modal[open] {
    display: flex;
    flex-direction: column;
    animation: pop 0.35s var(--ease);
  }
  .modal::backdrop {
    background: rgb(4 4 6 / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fade 0.3s ease;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .panels {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .foot {
    display: flex;
    justify-content: center;
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--line);
    background: var(--bg-elev);
  }
  .dock {
    display: flex;
    gap: 0.5rem;
    padding: 0.35rem;
    border-radius: 16px;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .dock-i {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 10px;
    opacity: 0.5;
    transition:
      opacity 0.2s,
      transform 0.25s var(--ease);
  }
  .dock-i:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .dock-i.on {
    opacity: 1;
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  /* Phones: a full-height bottom sheet */
  @media (max-width: 640px) {
    .modal {
      width: 100vw;
      max-width: 100vw;
      height: 94dvh;
      margin: auto 0 0;
      border-radius: 20px 20px 0 0;
      border-bottom: 0;
    }
    .modal[open] {
      animation: slide 0.35s var(--ease);
    }
    .dock {
      gap: 0.35rem;
    }
  }
  @keyframes slide {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
  }
</style>
