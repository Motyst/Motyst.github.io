---
import Media from './Media.astro';
import type { Project } from '@/lib/projects';

interface Props {
  items: Project['data']['gallery'];
  title: string;
  accent: string;
}

const { items, title, accent } = Astro.props;
---

<div class="gallery">
  {
    items.map((item, i) => (
      <figure class:list={['reveal', { wide: item.type !== 'image' || i === 0 }]} style={`--delay: ${(i % 2) * 80}ms`}>
        {item.type === 'image' ? (
          <button type="button" class="zoom" data-src={item.src} data-caption={item.caption ?? ''} aria-label="Enlarge image">
            <Media item={item} title={title} accent={accent} mode="full" />
          </button>
        ) : (
          <Media item={item} title={title} accent={accent} mode="full" />
        )}
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<dialog class="lightbox" aria-label="Image viewer">
  <form method="dialog"><button class="close" aria-label="Close">✕</button></form>
  <img alt="" />
  <p class="caption"></p>
</dialog>

<script>
  function initGallery() {
    const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    if (!dialog) return;
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector<HTMLElement>('.caption')!;

    document.querySelectorAll<HTMLButtonElement>('.gallery .zoom').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.src ?? '';
        img.alt = btn.dataset.caption ?? '';
        caption.textContent = btn.dataset.caption ?? '';
        dialog.showModal();
      });
    });
    // Click on the backdrop closes the dialog.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
  document.addEventListener('astro:page-load', initGallery);
</script>

<style>
  .gallery {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
    .wide {
      grid-column: 1 / -1;
    }
  }

  figure {
    margin: 0;
  }

  figure > :global(.media),
  .zoom {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .zoom {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    cursor: zoom-in;
  }

  .zoom :global(img) {
    transition: transform 0.6s var(--ease);
  }

  .zoom:hover :global(img) {
    transform: scale(1.02);
  }

  figcaption {
    margin-top: 0.7rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .lightbox {
    max-width: min(94vw, 1400px);
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.85);
    backdrop-filter: blur(6px);
  }

  .lightbox img {
    max-height: 86vh;
    width: auto;
    margin-inline: auto;
    border-radius: var(--radius);
  }

  .caption {
    text-align: center;
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-top: 0.8rem;
  }

  .close {
    position: absolute;
    top: -2.75rem;
    right: 0;
    background: none;
    border: 0;
    color: var(--text);
    font-size: 1.25rem;
    cursor: pointer;
  }
</style>
