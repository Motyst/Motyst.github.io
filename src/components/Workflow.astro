---
/**
 * A project's workflow as a visual pipeline: coloured step icons joined by
 * connectors. Horizontal when there is room, vertical on narrow screens.
 */
import { stepColors, stepIcons } from '@/data/step-icons';

interface Props {
  steps: { title: string; description: string; icon?: string }[];
}

const { steps } = Astro.props;
const color = (i: number) => stepColors[i % stepColors.length];
---

<div class="wf">
  <ol class="pipe" style={`--n: ${steps.length}`}>
    {
      steps.map((step, i) => (
        <li style={`--c: ${color(i)}; --c2: ${color(i + 1)}`}>
          <span class="badge" aria-hidden="true">
            {step.icon && stepIcons[step.icon] ? (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={stepIcons[step.icon]}
              />
            ) : (
              <span class="num">{i + 1}</span>
            )}
          </span>
          <span class="txt">
            <strong>
              <span class="step mono">{String(i + 1).padStart(2, '0')}</span>
              {step.title}
            </strong>
            <span class="d">{step.description}</span>
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .wf {
    container-type: inline-size;
  }

  .pipe {
    --gap: 0.9rem;
    --b: 46px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gap);
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: var(--b) 1fr;
    gap: 0.9rem;
    align-items: start;
    align-content: start;
  }

  /* Vertical connector (narrow) */
  li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--b) / 2 - 1px);
    top: calc(var(--b) + 6px);
    bottom: calc(-1 * var(--gap) + 6px);
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(var(--c), var(--c2));
    opacity: 0.55;
  }

  .badge {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--b);
    height: var(--b);
    border-radius: 14px;
    color: var(--c);
    background: color-mix(in oklab, var(--c) 14%, var(--bg-elev));
    border: 1px solid color-mix(in oklab, var(--c) 40%, transparent);
    box-shadow: 0 8px 24px -12px var(--c);
  }
  .badge svg {
    width: 22px;
    height: 22px;
  }
  .num {
    font-weight: 700;
  }

  .txt {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.15rem;
  }
  strong {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }
  .step {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--c);
  }
  .d {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-dim);
  }

  /* Horizontal pipeline when each step gets at least ~150px */
  @container (min-width: 640px) {
    .pipe {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
    li {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    li:not(:last-child)::before {
      left: calc(var(--b) + 8px);
      right: calc(-1 * var(--gap) + 8px);
      top: calc(var(--b) / 2 - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--c), var(--c2));
    }
    /* Little arrow head at the end of each connector */
    li:not(:last-child)::after {
      content: '';
      position: absolute;
      right: calc(-1 * var(--gap) + 7px);
      top: calc(var(--b) / 2 - 4px);
      width: 7px;
      height: 7px;
      border-top: 2px solid var(--c2);
      border-right: 2px solid var(--c2);
      transform: rotate(45deg);
      opacity: 0.7;
    }

    /* Lab variant wf-center: each step centred in its column (.wf-center = lab card preview) */
    :global(html[data-lab='wf-center']) li,
    :global(.wf-center) li {
      justify-items: center;
      text-align: center;
    }
    :global(html[data-lab='wf-center']) strong,
    :global(.wf-center) strong {
      justify-content: center;
    }
    :global(html[data-lab='wf-center']) li:not(:last-child)::before,
    :global(.wf-center) li:not(:last-child)::before {
      left: calc(50% + var(--b) / 2 + 8px);
      right: calc(-1 * var(--gap) - 50% + var(--b) / 2 + 8px);
    }
    :global(html[data-lab='wf-center']) li:not(:last-child)::after,
    :global(.wf-center) li:not(:last-child)::after {
      right: calc(-1 * var(--gap) - 50% + var(--b) / 2 + 7px);
    }
  }
</style>
