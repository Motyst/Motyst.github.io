---
/**
 * One project inside the project window: header, media, links, workflow,
 * story and skills. Rendered hidden; ProjectDialog shows one at a time.
 */
import { render } from 'astro:content';
import ProjectIcon from './ProjectIcon.astro';
import ProjectBanner from './ProjectBanner.astro';
import Showcase from './Showcase.astro';
import Workflow from './Workflow.astro';
import LinkButton from './LinkButton.astro';
import Icon from './Icon.astro';
import { skillIcon } from '@/data/ui-icons';
import type { Project } from '@/lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data, id } = project;
const { Content } = await render(project);

// Cover first, then the gallery, without showing the same file twice.
const media = [data.cover, ...data.gallery].filter(
  (m, i, all): m is NonNullable<typeof m> => !!m && all.findIndex((o) => o?.src === m.src) === i,
);
---

<article class="panel" data-panel={id} hidden aria-labelledby={`project-${id}-title`} style={`--c: ${data.accent}`}>
    <header class="head">
      <ProjectIcon icon={data.icon} title={data.title} accent={data.accent} size={46} />
      <div class="head-text">
        <h2 id={`project-${id}-title`}>{data.title}</h2>
      </div>
      <a href={`/work/${id}`} class="close" title="Open as a full page" aria-label="Open as a full page">⤢</a>
      <button type="button" class="close" data-close aria-label="Close">✕</button>
    </header>

    <div class="scroll" tabindex="-1">
      <div class="intro">
        <p class="tagline">{data.tagline}</p>
        {
          data.links.length > 0 && (
            <div class="links">
              {data.links.map((l) => (
                <LinkButton {...l} />
              ))}
            </div>
          )
        }
      </div>

      {
        media.length === 0 ? (
          <div class="banner-box">
            <ProjectBanner icon={data.icon} title={data.title} accent={data.accent} />
          </div>
        ) : (
          <Showcase items={media} title={data.title} accent={data.accent} />
        )
      }

      {
        data.workflow.length > 0 && (
          <section class="flow" id={`how-${id}`}>
            <Workflow steps={data.workflow} title="How it works" />
          </section>
        )
      }

      <div class="cols">
        <div class="prose">
          <Content />
        </div>

        <aside class="side">
          {
            data.highlights.length > 0 && (
              <section>
                <h3 class="eyebrow">Highlights</h3>
                <ul class="highlights">
                  {data.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              </section>
            )
          }
          <section>
            <h3 class="eyebrow">Skills</h3>
            <ul class="skills">
              {data.skills.map((s) => (
                <li class="chip">
                  {skillIcon[s] && <Icon name={skillIcon[s]} size={13} class="si" />}
                  {s}
                </li>
              ))}
            </ul>
          </section>
          {
            data.private && (
              <p class="private">Private codebase. A walkthrough is available on request.</p>
            )
          }
        </aside>
      </div>

    </div>
</article>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }
  .panel[hidden] {
    display: none;
  }
  /* Slide in from the side we are moving towards */
  .panel.in-right {
    animation: in-right 0.32s var(--ease);
  }
  .panel.in-left {
    animation: in-left 0.32s var(--ease);
  }
  @keyframes in-right {
    from {
      opacity: 0;
      transform: translateX(28px);
    }
  }
  @keyframes in-left {
    from {
      opacity: 0;
      transform: translateX(-28px);
    }
  }

  .head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.5rem;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(60% 200% at 0% 0%, color-mix(in oklab, var(--c) 14%, transparent), transparent 70%),
      var(--bg-elev);
  }
  .head-text {
    min-width: 0;
    flex: 1;
  }
  h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.6rem);
    letter-spacing: -0.03em;
  }
  .close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: none;
    color: var(--text-dim);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .close:hover {
    color: var(--text);
    border-color: var(--text-dim);
  }

  .scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.1rem 1.5rem 1.5rem;
    display: grid;
    grid-auto-rows: max-content;
    gap: 1.1rem;
    outline: none;
  }

  /* Screenshots get the height that leaves everything down to "How it works" in view */
  .scroll {
    --stage-h: clamp(220px, min(90vh, 900px) - 278px, 620px);
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .tagline {
    flex: 1 1 32ch;
    font-size: clamp(1.02rem, 2vw, 1.12rem);
    line-height: 1.55;
    color: var(--text-dim);
    max-width: 60ch;
  }

  /* Wider windows: the description on the left, screenshots beside it */
  @media (min-width: 761px) {
    .scroll {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr);
      column-gap: 1.5rem;
      --stage-h: clamp(240px, min(90vh, 900px) - 196px, 640px);
    }
    .scroll > :global(*) {
      grid-column: 1 / -1;
    }
    .scroll > .intro {
      grid-column: 1;
      grid-row: 1;
      flex-direction: column;
      align-self: center;
      gap: 1.25rem;
    }
    .intro .tagline {
      flex: none;
      color: var(--text);
    }
    .scroll > :global(.show),
    .scroll > .banner-box {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .banner-box {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .banner-box :global(.banner) {
    aspect-ratio: 16 / 10;
    max-height: var(--stage-h);
    width: 100%;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cols {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 760px) {
    .cols {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  .prose {
    color: var(--text-dim);
    font-size: 0.98rem;
  }
  .prose :global(p + p),
  .prose :global(ul),
  .prose :global(pre) {
    margin-top: 0.9rem;
  }
  .prose :global(h2) {
    color: var(--text);
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    margin: 1.5rem 0 0.5rem;
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(a) {
    color: var(--text);
    border-bottom: 1px solid var(--c);
  }
  .prose :global(ul) {
    padding-left: 1.1rem;
  }
  .prose :global(li + li) {
    margin-top: 0.3rem;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 0.1em 0.35em;
    border-radius: 5px;
    background: var(--bg-soft);
  }

  .side {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .eyebrow {
    margin-bottom: 0.6rem;
  }
  .highlights li {
    display: flex;
    gap: 0.6rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .highlights li::before {
    content: '✦';
    color: var(--c);
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .skills .chip {
    font-size: 0.75rem;
  }
  .skills :global(.si) {
    color: var(--c);
  }
  .highlights,
  .skills {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .skills {
    display: flex;
  }
  .private {
    padding: 0.75rem 0.9rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  /* Phones: a full-height bottom sheet */
  @media (max-width: 640px) {
    .head,
    .scroll {
      padding-inline: 1rem;
    }
    .head {
      gap: 0.75rem;
    }
    h2 {
      font-size: 1.2rem;
    }
  }
</style>
