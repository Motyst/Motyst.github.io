---
/**
 * Visual stand-in for projects without screenshots yet: the project icon
 * floating on an accent-tinted grid.
 */
import ProjectIcon from './ProjectIcon.astro';

interface Props {
  icon?: string;
  title: string;
  accent: string;
}

const { icon, title, accent } = Astro.props;
---

<div class="banner" style={`--c: ${accent}`}>
  <div class="grid" aria-hidden="true"></div>
  <div class="rings" aria-hidden="true"><i></i><i></i><i></i></div>
  <ProjectIcon icon={icon} title={title} accent={accent} size={96} />
</div>

<style>
  .banner {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background:
      radial-gradient(60% 90% at 50% 50%, color-mix(in oklab, var(--c) 22%, transparent), transparent 70%),
      var(--bg-soft);
  }
  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, #000 20%, transparent 70%);
  }
  .rings i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 140px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--c) 40%, transparent);
    translate: -50% -50%;
    animation: ripple 4.5s ease-out infinite;
    opacity: 0;
  }
  .rings i:nth-child(2) {
    animation-delay: 1.5s;
  }
  .rings i:nth-child(3) {
    animation-delay: 3s;
  }
  @keyframes ripple {
    0% {
      opacity: 0.8;
      scale: 0.7;
    }
    100% {
      opacity: 0;
      scale: 2.6;
    }
  }
  .banner :global(.icon) {
    position: relative;
  }
</style>
