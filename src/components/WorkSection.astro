---
import ProjectIcon from './ProjectIcon.astro';
import ProjectDialog from './ProjectDialog.astro';
import type { Project } from '@/lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

---

<section class="section" id="work">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Selected work · {projects.length} projects</span>
        <h2>Things I've built</h2>
      </div>
      <p>Tap a project to see how it works, the stack behind it and what it looks like.</p>
    </div>

    <ul class="tiles">
      {
        projects.map((p, i) => (
          <li class:list={['reveal', { feat: p.data.featured }]} style={`--delay: ${(i % 3) * 70}ms`}>
            <button type="button" class="tile" data-open={p.id} style={`--c: ${p.data.accent}`}>
              <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={60} />
              <span class="txt">
                <span class="t">{p.data.title}</span>
                <span class="s">{p.data.summary ?? p.data.tagline}</span>
                {p.data.featured && <span class="s long">{p.data.tagline}</span>}
              </span>
              <span class="go" aria-hidden="true">
                ↗
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <ProjectDialog projects={projects} />
</section>


<style>
  /* Flex so the last row always stretches to full width */
  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tiles > li {
    flex: 1 1 320px;
  }

  .tile {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    width: 100%;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(90% 140% at 0% 50%, color-mix(in oklab, var(--c) 9%, transparent), transparent 60%),
      var(--bg-elev);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition:
      border-color 0.25s,
      transform 0.35s var(--ease),
      background 0.25s;
  }
  .tile:hover {
    border-color: color-mix(in oklab, var(--c) 50%, transparent);
    transform: translateY(-2px);
  }
  .tile :global(.icon) {
    transition: transform 0.4s var(--ease);
  }
  .tile:hover :global(.icon) {
    transform: scale(1.06) rotate(-3deg);
  }

  .txt {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .t {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.015em;
  }
  .s {
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.4;
  }

  .go {
    margin-left: auto;
    align-self: flex-start;
    color: var(--text-faint);
    transition:
      color 0.2s,
      transform 0.3s var(--ease);
  }
  .tile:hover .go {
    color: var(--c);
    transform: translate(2px, -2px);
  }

  /* Phones: one project per row so the full line stays readable */
  @media (max-width: 560px) {
    .tiles {
      gap: 0.6rem;
    }
    .tiles > li {
      flex-basis: 100%;
    }
    .tile {
      gap: 0.9rem;
      padding: 0.9rem 1rem;
    }
    .tile :global(.icon) {
      width: 52px;
      height: 52px;
    }
    .t {
      font-size: 0.98rem;
    }
    .s {
      font-size: 0.84rem;
    }
    .go {
      position: absolute;
      top: 0.8rem;
      right: 0.9rem;
    }
  }
  /* ---------- Design lab variants (round 8: grid layout) ---------- */
  .long {
    display: none;
  }

  /* A: same-size tiles, a short last row is centred */
  :global(html[data-lab='grid-centred']) .tiles {
    justify-content: center;
  }
  :global(html[data-lab='grid-centred']) .tiles > li {
    flex: 0 1 calc((100% - 2 * 0.9rem) / 3);
  }
  @media (max-width: 999px) {
    :global(html[data-lab='grid-centred']) .tiles > li {
      flex-basis: calc((100% - 0.9rem) / 2);
    }
  }

  /* B: bento, featured projects get a wide tile with their tagline */
  :global(html[data-lab='grid-bento']) .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
  }
  :global(html[data-lab='grid-bento']) .feat {
    grid-column: span 2;
  }
  :global(html[data-lab='grid-bento']) .feat .tile {
    padding: 1.4rem 1.5rem;
    gap: 1.3rem;
  }
  :global(html[data-lab='grid-bento']) .feat .tile :global(.icon) {
    width: 76px;
    height: 76px;
  }
  :global(html[data-lab='grid-bento']) .feat .t {
    font-size: 1.2rem;
  }
  :global(html[data-lab='grid-bento']) .feat .s:not(.long) {
    display: none;
  }
  :global(html[data-lab='grid-bento']) .feat .long {
    display: block;
    max-width: 52ch;
  }
  @media (max-width: 999px) {
    :global(html[data-lab='grid-bento']) .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* C: a list, one project per row with the summary beside the title */
  :global(html[data-lab='grid-list']) .tiles {
    gap: 0.6rem;
  }
  :global(html[data-lab='grid-list']) .tiles > li {
    flex-basis: 100%;
  }
  :global(html[data-lab='grid-list']) .tile {
    padding: 0.8rem 1.25rem 0.8rem 0.9rem;
  }
  :global(html[data-lab='grid-list']) .tile :global(.icon) {
    width: 48px;
    height: 48px;
  }
  :global(html[data-lab='grid-list']) .go {
    align-self: center;
  }
  @media (min-width: 761px) {
    :global(html[data-lab='grid-list']) .txt {
      flex-direction: row;
      align-items: baseline;
      gap: 1.5rem;
    }
    :global(html[data-lab='grid-list']) .t {
      flex: none;
      width: 17rem;
    }
  }

  /* Phones: every variant is one project per row */
  @media (max-width: 560px) {
    :global(html[data-lab]) .tiles {
      display: flex;
    }
    :global(html[data-lab]) .tiles > li {
      flex-basis: 100%;
    }
  }
</style>
