---
import ProjectIcon from './ProjectIcon.astro';
import ProjectModal from './ProjectModal.astro';
import type { Project } from '@/lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const at = (i: number) => projects[(i + projects.length) % projects.length];
---

<section class="section" id="work">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Selected work · {projects.length} projects</span>
        <h2>Things I've built</h2>
      </div>
      <p>Tap a project to see how it works, the stack behind it and what it looks like.</p>
    </div>

    <ul class="tiles">
      {
        projects.map((p, i) => (
          <li class="reveal" style={`--delay: ${(i % 3) * 70}ms`}>
            <button type="button" class="tile" data-open={p.id} style={`--c: ${p.data.accent}`}>
              <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={60} />
              <span class="txt">
                <span class="t">{p.data.title}</span>
                <span class="s">{p.data.summary ?? p.data.tagline}</span>
              </span>
              <span class="go" aria-hidden="true">
                ↗
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  {projects.map((p, i) => <ProjectModal project={p} prev={at(i - 1)} next={at(i + 1)} />)}
</section>

<script>
  // Project windows: any [data-open="<id>"] opens #project-<id>.
  // The open project is kept in the URL (?project=<id>) so it can be shared.
  function initProjects() {
    const setParam = (id: string | null) => {
      const url = new URL(location.href);
      if (id) url.searchParams.set('project', id);
      else url.searchParams.delete('project');
      history.replaceState(history.state, '', url);
    };

    const open = (id: string) => {
      const dialog = document.getElementById(`project-${id}`) as HTMLDialogElement | null;
      if (!dialog) return;
      document.querySelectorAll<HTMLDialogElement>('dialog.modal[open]').forEach((d) => d !== dialog && d.close());
      if (!dialog.open) dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      dialog.querySelector<HTMLElement>('.scroll')?.scrollTo(0, 0);
      setParam(id);
    };

    document.querySelectorAll<HTMLElement>('[data-open]').forEach((el) =>
      el.addEventListener('click', () => open(el.dataset.open!)),
    );

    document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach((dialog) => {
      dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      // A click on the backdrop (outside the sheet) closes the window.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => {
        dialog.querySelectorAll('video').forEach((v) => v.pause());
        if (!document.querySelector('dialog.modal[open]')) {
          document.documentElement.style.overflow = '';
          setParam(null);
        }
      });

      // Media strip: arrows + counter
      const strip = dialog.querySelector<HTMLElement>('[data-strip]');
      const count = dialog.querySelector<HTMLElement>('[data-strip-count]');
      if (strip) {
        const total = strip.children.length;
        dialog.querySelectorAll<HTMLButtonElement>('[data-strip-go]').forEach((b) =>
          b.addEventListener('click', () =>
            strip.scrollBy({ left: Number(b.dataset.stripGo) * strip.clientWidth, behavior: 'smooth' }),
          ),
        );
        strip.addEventListener('scroll', () => {
          if (count) count.textContent = `${Math.round(strip.scrollLeft / strip.clientWidth) + 1} / ${total}`;
        });
      }
    });

    const initial = new URLSearchParams(location.search).get('project');
    if (initial) open(initial);
  }

  document.addEventListener('astro:page-load', initProjects);
</script>

<style>
  /* Flex so the last row always stretches to full width */
  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tiles > li {
    flex: 1 1 320px;
  }

  .tile {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    width: 100%;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(90% 140% at 0% 50%, color-mix(in oklab, var(--c) 9%, transparent), transparent 60%),
      var(--bg-elev);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition:
      border-color 0.25s,
      transform 0.35s var(--ease),
      background 0.25s;
  }
  .tile:hover {
    border-color: color-mix(in oklab, var(--c) 50%, transparent);
    transform: translateY(-2px);
  }
  .tile :global(.icon) {
    transition: transform 0.4s var(--ease);
  }
  .tile:hover :global(.icon) {
    transform: scale(1.06) rotate(-3deg);
  }

  .txt {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .t {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.015em;
  }
  .s {
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.4;
  }

  .go {
    margin-left: auto;
    align-self: flex-start;
    color: var(--text-faint);
    transition:
      color 0.2s,
      transform 0.3s var(--ease);
  }
  .tile:hover .go {
    color: var(--c);
    transform: translate(2px, -2px);
  }

  /* Phones: two columns of app-style tiles so every project fits on screen */
  @media (max-width: 560px) {
    .tiles {
      gap: 0.6rem;
    }
    .tiles > li {
      flex: 1 1 calc(50% - 0.3rem);
    }
    .tile {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
      padding: 1rem;
    }
    .t {
      font-size: 0.95rem;
    }
    .s {
      font-size: 0.8rem;
    }
    .go {
      position: absolute;
      top: 0.8rem;
      right: 0.9rem;
    }
  }
</style>
