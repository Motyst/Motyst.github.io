---
import { groupSkills, type Project } from '@/lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const groups = groupSkills(projects);
---

<section class="section" id="skills">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Skills</span>
        <h2>What I work with</h2>
      </div>
      <p>The core of my toolkit, all used in the projects above.</p>
    </div>

    <div class="groups">
      {
        groups.map((g, i) => (
          <div class="group reveal" style={`--delay: ${i * 60}ms`}>
            <h3>{g.category}</h3>
            <ul>
              {g.skills.map((s) => (
                <li>{s.name}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }

  .group {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }

  h3 {
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.8rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 0.28em 0.7em;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.02);
    font-size: 0.8rem;
    color: var(--text-dim);
  }
</style>
