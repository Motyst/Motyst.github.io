---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Showcase from '@/components/Showcase.astro';
import ProjectIcon from '@/components/ProjectIcon.astro';
import ProjectBanner from '@/components/ProjectBanner.astro';
import LinkButton from '@/components/LinkButton.astro';
import Workflow from '@/components/Workflow.astro';
import { getProjects, type Project } from '@/lib/projects';
import Icon from '@/components/Icon.astro';
import { skillIcon } from '@/data/ui-icons';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { data, id } = project;
const { Content } = await render(project);

const ogImage = data.cover?.type === 'image' ? data.cover.src : data.cover?.poster;

// Cover first, then the gallery, without showing the same file twice.
const media = [data.cover, ...data.gallery].filter(
  (m, i, all): m is NonNullable<typeof m> => !!m && all.findIndex((o) => o?.src === m.src) === i,
);
---

<Base title={data.title} description={data.tagline} image={ogImage}>
  <article style={`--accent: ${data.accent}`}>
    <section class="section head">
      <div class="container">
        <a href="/#work" class="back mono">← All work</a>
        <div class="top">
          <div class="intro">
            <div class="title-row">
              <ProjectIcon icon={data.icon} title={data.title} accent={data.accent} size={60} />
              <h1>{data.title}</h1>
            </div>
            <p class="tagline">{data.tagline}</p>
            {
              data.links.length > 0 && (
                <div class="links">
                  {data.links.map((link) => (
                    <LinkButton {...link} />
                  ))}
                </div>
              )
            }
          </div>
          <div class="visual">
            {
              media.length > 0 ? (
                <Showcase items={media} title={data.title} accent={data.accent} />
              ) : (
                <div class="banner-box">
                  <ProjectBanner icon={data.icon} title={data.title} accent={data.accent} />
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container body">
      <div class="prose reveal">
        <span class="eyebrow">Overview</span>
        <Content />
      </div>

      <aside class="side reveal" style="--delay: 120ms">
        {
          data.private && (
            <p class="private">
              <span aria-hidden="true">◌</span> Private codebase. A walkthrough is available on request.
            </p>
          )
        }
        {
          data.highlights.length > 0 && (
            <section>
              <h2 class="eyebrow">Highlights</h2>
              <ul class="highlights">
                {data.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </section>
          )
        }
        {
          data.skills.length > 0 && (
            <section>
              <h2 class="eyebrow">Skills used</h2>
              <ul class="skills">
                {data.skills.map((s) => (
                  <li>
                    <span class="chip">
                      {skillIcon[s] && <Icon name={skillIcon[s]} size={13} class="si" />}
                      {s}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
      </div>
    </section>

    {
      data.workflow.length > 0 && (
        <section class="section">
          <div class="container">
            <div class="section-head reveal">
              <div>
                <span class="eyebrow">Workflow</span>
                <h2>How it works</h2>
              </div>
            </div>
            <Workflow steps={data.workflow} />
          </div>
        </section>
      )
    }

    {
      next.id !== id && (
        <section class="section">
          <a href={`/work/${next.id}`} class="container next reveal" style={`--accent: ${next.data.accent}`}>
            <span class="eyebrow">Next project</span>
            <span class="next-row">
              <ProjectIcon icon={next.data.icon} title={next.data.title} accent={next.data.accent} size={56} />
              <span>
                <span class="next-title">
                  {next.data.title} <span class="arrow">→</span>
                </span>
                <span class="next-tag">{next.data.summary ?? next.data.tagline}</span>
              </span>
            </span>
          </a>
        </section>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(2rem, 5vw, 3rem);
  }

  .back {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--text-faint);
    margin-bottom: 1.5rem;
    transition: color 0.2s, transform 0.3s var(--ease);
  }

  .back:hover {
    color: var(--text);
    transform: translateX(-3px);
  }

  /* Description on the left, screenshots beside it (stacked on narrow screens) */
  .top {
    display: grid;
    gap: 2rem;
    align-items: center;
    --stage-h: clamp(260px, 62vh, 500px);
  }
  @media (min-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr);
      gap: 3rem;
    }
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  h1 {
    font-size: clamp(2.1rem, 4.5vw, 3.1rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .tagline {
    margin-top: 1.1rem;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.55;
    color: var(--text-dim);
    max-width: 44ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .banner-box {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .banner-box :global(.banner) {
    aspect-ratio: 16 / 9;
  }

  .body {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: 4rem;
    }
    .side {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }

  .prose {
    font-size: 1.02rem;
    color: var(--text-dim);
    max-width: 68ch;
  }

  .prose :global(p + p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre) {
    margin-top: 1.1rem;
  }

  .prose :global(h2),
  .prose :global(h3) {
    color: var(--text);
    margin: 2.25rem 0 0.75rem;
    font-size: 1.4rem;
  }

  .prose :global(strong) {
    color: var(--text);
  }

  .prose :global(a) {
    color: var(--text);
    border-bottom: 1px solid var(--accent);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--bg-soft);
  }

  .prose :global(pre) {
    padding: 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    overflow-x: auto;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }

  .prose :global(li + li) {
    margin-top: 0.4rem;
  }

  .prose :global(img) {
    border-radius: var(--radius);
    margin-block: 1.5rem;
  }

  .side {
    display: grid;
    gap: 1.75rem;
  }

  .private {
    display: flex;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    font-size: 0.88rem;
    color: var(--text-dim);
  }

  .private span {
    color: var(--accent);
  }

  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .highlights li {
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 0.75rem;
  }

  .highlights li::before {
    content: '✦';
    color: var(--accent);
  }

  .skills :global(.si) {
    color: var(--accent);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .section-head h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }

  .next {
    display: block;
  }

  .next-row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .next-title {
    display: block;
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.05;
    transition: color 0.3s;
  }

  .next:hover .next-title {
    color: var(--accent);
  }

  .next .arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }

  .next:hover .arrow {
    transform: translateX(8px);
  }

  .next-tag {
    display: block;
    margin-top: 0.4rem;
    color: var(--text-dim);
  }
</style>
