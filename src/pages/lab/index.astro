---
/**
 * Design lab: a temporary, unlisted page comparing the live design with
 * new ideas side by side. Not linked anywhere, excluded from search/sitemap.
 *
 * Click an option to choose it, add comments, then copy the generated reply
 * into the chat. For the next round, bump `round`, update `applied` and swap
 * the <Question> blocks.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Question from '@/components/lab/Question.astro';
import Choice from '@/components/lab/Choice.astro';
import ProjectIcon from '@/components/ProjectIcon.astro';
import { profile } from '@/data/profile';
import { getProjects } from '@/lib/projects';

const round = 3;
const applied = ['“Email me” + copy button', 'Colour glow background'];
const projects = (await getProjects()).slice(0, 4);
const headlines = {
  a: 'I build AI bots and automations that take repetitive work off people’s plates.',
  b: 'I turn repetitive work into bots and AI pipelines that run on their own.',
};
---

<Base title="Design lab" noindex>
  <div class="container lab" data-round={round}>
    <header class="intro">
      <span class="eyebrow">Design lab · round {round}</span>
      <h1>Pick what you like</h1>
      <ol class="how">
        <li>Click an option to choose it</li>
        <li>Add a comment if you want</li>
        <li>Copy the reply and paste it into the chat</li>
      </ol>
      <p class="applied">
        <span>Applied from round {round - 1}:</span>
        {applied.map((a) => <em><Icon name="check" size={13} /> {a}</em>)}
      </p>
    </header>

    <Question n={1} title="Your photo" why="A face makes a portfolio feel personal and builds trust. You would send me a photo.">
      <Choice label="Current" name="No photo" note="All about the work. Clean, but a bit anonymous.">
        <div class="frame about">
          <div class="txt"><p class="k">About</p><p class="h">A bit about me</p><i></i><i></i><i class="short"></i></div>
        </div>
      </Choice>
      <Choice label="A" name="Photo in About" note="A round photo next to your bio. The top of the page stays about the projects." mine>
        <div class="frame about">
          <span class="avatar big"><Icon name="user-check" size={26} /></span>
          <div class="txt"><p class="k">About</p><p class="h">A bit about me</p><i></i><i></i><i class="short"></i></div>
        </div>
      </Choice>
      <Choice label="B" name="Photo in the hero" note="A small photo right above your name. Personal from the first second.">
        <div class="frame">
          <div class="stub">
            <span class="avatar"><Icon name="user-check" size={16} /></span>
            <p class="k">AI Automation Developer · Dublin</p>
            <p class="n">{profile.name}.</p>
          </div>
        </div>
      </Choice>
    </Question>

    <Question n={2} title="Projects on phones" why="On phones the tiles are two columns, so the new, longer one-liners wrap into narrow blocks.">
      <Choice label="Current" name="Two columns" note="App-style grid. Icons are big, but text gets squeezed.">
        <div class="phone">
          <ul class="grid2">
            {projects.map((p) => (
              <li><ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={24} /><b>{p.data.title}</b><small>{p.data.summary}</small></li>
            ))}
          </ul>
        </div>
      </Choice>
      <Choice label="A" name="One-column rows" note="Icon on the left, the full line on the right. Easier to read, a bit shorter overall." mine>
        <div class="phone">
          <ul class="rows">
            {projects.map((p) => (
              <li><ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={26} /><span><b>{p.data.title}</b><small>{p.data.summary}</small></span></li>
            ))}
          </ul>
        </div>
      </Choice>
    </Question>

    <Question n={3} title="Headline under your name" why="The first sentence people read. It could say more about the value, not just the tech.">
      <Choice label="Current" name="What I build" note="Accurate and neutral. Lists the kinds of things you make.">
        <div class="frame head"><p class="n">{profile.name}.</p><p class="lead">{profile.headline}</p></div>
      </Choice>
      <Choice label="A" name="Who it helps" note="Puts the people who use your bots first.">
        <div class="frame head"><p class="n">{profile.name}.</p><p class="lead">{headlines.a}</p></div>
      </Choice>
      <Choice label="B" name="What it replaces" note="Short and outcome-first: manual work in, running system out." mine>
        <div class="frame head"><p class="n">{profile.name}.</p><p class="lead">{headlines.b}</p></div>
      </Choice>
    </Question>

    <section class="reply">
      <h2>Your reply</h2>
      <textarea data-overall rows="2" placeholder="Anything else? Other ideas, things you'd like to see compared next…"></textarea>
      <pre data-out></pre>
      <button type="button" class="copy-btn" data-copy-reply>
        <Icon name="copy" size={16} /> <span>Copy reply</span>
      </button>
    </section>
  </div>

  <div class="bar">
    <span data-count></span>
    <button type="button" class="copy-btn" data-copy-reply>
      <Icon name="copy" size={16} /> <span>Copy reply</span>
    </button>
  </div>
</Base>

<script>
  function initLab() {
    const lab = document.querySelector<HTMLElement>('.lab[data-round]');
    if (!lab) return;
    const key = `design-lab-${lab.dataset.round}`;
    const questions = [...lab.querySelectorAll<HTMLElement>('[data-q]')];
    const overall = lab.querySelector<HTMLTextAreaElement>('[data-overall]')!;
    const out = lab.querySelector<HTMLElement>('[data-out]')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;

    const build = () => {
      const lines = [`Design lab round ${lab.dataset.round} picks:`];
      let picked = 0;
      questions.forEach((q, i) => {
        const c = q.querySelector<HTMLElement>('.opt.chosen');
        if (c) picked++;
        lines.push(`${i + 1}. ${q.dataset.q}: ${c ? `${c.dataset.label} (${c.dataset.name})` : 'no pick'}`);
        const note = q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value.trim();
        if (note) lines.push(`   Comment: ${note}`);
      });
      if (overall.value.trim()) lines.push(`Overall: ${overall.value.trim()}`);
      out.textContent = lines.join('\n');
      count.textContent = `${picked} of ${questions.length} chosen`;
      save();
    };

    // Remember picks and comments in this browser (nice to have only).
    const save = () => {
      try {
        const state = questions.map((q) => ({
          pick: q.querySelector<HTMLElement>('.opt.chosen')?.dataset.label ?? null,
          note: q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value,
        }));
        localStorage.setItem(key, JSON.stringify({ state, overall: overall.value }));
      } catch {}
    };
    const choose = (opt: HTMLElement) => {
      const q = opt.closest('[data-q]')!;
      const was = opt.classList.contains('chosen');
      q.querySelectorAll<HTMLElement>('.opt').forEach((o) => {
        o.classList.remove('chosen');
        o.querySelector('[data-choose]')!.setAttribute('aria-pressed', 'false');
      });
      if (!was) {
        opt.classList.add('chosen');
        opt.querySelector('[data-choose]')!.setAttribute('aria-pressed', 'true');
      }
    };

    try {
      const saved = JSON.parse(localStorage.getItem(key) ?? 'null');
      saved?.state?.forEach((s: { pick: string | null; note: string }, i: number) => {
        const q = questions[i];
        if (!q) return;
        const opt = s.pick && q.querySelector<HTMLElement>(`.opt[data-label="${s.pick}"]`);
        if (opt) choose(opt);
        q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value = s.note ?? '';
      });
      if (saved?.overall) overall.value = saved.overall;
    } catch {}

    lab.querySelectorAll<HTMLElement>('.opt').forEach((opt) =>
      opt.addEventListener('click', () => {
        choose(opt);
        build();
      }),
    );
    lab.addEventListener('input', build);

    document.querySelectorAll<HTMLButtonElement>('[data-copy-reply]').forEach((b) =>
      b.addEventListener('click', async () => {
        const text = out.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const t = document.createElement('textarea');
          t.value = text;
          t.style.position = 'fixed';
          t.style.opacity = '0';
          document.body.append(t);
          t.select();
          document.execCommand('copy');
          t.remove();
        }
        const label = b.querySelector('span')!;
        b.classList.add('done');
        label.textContent = 'Copied, paste it in the chat';
        setTimeout(() => {
          b.classList.remove('done');
          label.textContent = 'Copy reply';
        }, 2200);
      }),
    );

    build();
  }
  document.addEventListener('astro:page-load', initLab);
</script>

<style>
  .lab {
    padding-block: clamp(2rem, 5vw, 3rem) 6rem;
  }
  .intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.9rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-dim);
  }
  .how li::marker {
    color: var(--text-faint);
  }
  .applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }
  .applied em {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(34 197 94 / 0.3);
    color: #86efac;
    font-style: normal;
  }

  /* Mini page frame */
  .frame {
    position: relative;
    height: 150px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg);
    overflow: hidden;
  }
  .stub {
    position: absolute;
    left: 16px;
    bottom: 22px;
  }
  .stub .k {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .stub .n {
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -0.05em;
    margin-top: 4px;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #a78bfa, #4cc9f0);
    color: rgb(255 255 255 / 0.85);
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px var(--line-strong);
  }
  .avatar.big {
    position: absolute;
    left: 16px;
    top: 50%;
    translate: 0 -50%;
    width: 72px;
    height: 72px;
    margin: 0;
  }

  /* About mock */
  .about .txt {
    position: absolute;
    inset: 22px 16px auto 16px;
  }
  .about .avatar.big + .txt {
    left: 106px;
  }
  .txt .h {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 2px 0 10px;
  }
  .txt i {
    display: block;
    height: 6px;
    margin-top: 7px;
    border-radius: 4px;
    background: var(--bg-soft);
  }
  .txt i.short {
    width: 60%;
  }
  .txt .k,
  .stub .k {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* Headline mock */
  .frame.head {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 0 16px;
  }
  .head .n {
    font-size: 26px;
    font-weight: 650;
    letter-spacing: -0.05em;
  }
  .head .lead {
    color: var(--text-dim);
    font-size: 13px;
    line-height: 1.45;
  }

  /* Phone mock */
  .phone {
    width: 220px;
    margin: 0 auto;
    padding: 10px;
    border: 1px solid var(--line-strong);
    border-radius: 22px;
    background: var(--bg);
  }
  .phone ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .phone li {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-elev);
    padding: 8px;
    min-width: 0;
  }
  .phone b {
    display: block;
    font-size: 9.5px;
    font-weight: 600;
    line-height: 1.25;
  }
  .phone small {
    display: block;
    font-size: 8.5px;
    line-height: 1.35;
    color: var(--text-dim);
  }
  .grid2 {
    grid-template-columns: 1fr 1fr;
  }
  .grid2 li {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .rows li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Reply */
  .reply {
    margin-top: 4rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }
  .reply h2 {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .reply textarea {
    display: block;
    width: 100%;
    margin-top: 0.9rem;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    resize: vertical;
    field-sizing: content;
    min-height: 4rem;
  }
  .reply textarea:focus {
    outline: none;
    border-color: var(--line-strong);
  }
  pre {
    margin: 0.9rem 0;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: var(--bg);
    border: 1px dashed var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-dim);
    white-space: pre-wrap;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-btn:hover {
    background: #fff;
  }
  .copy-btn.done {
    background: #16a34a;
    color: #fff;
  }

  /* Sticky bar at the bottom of the screen */
  .bar {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    translate: -50% 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.4rem 0.4rem 0.4rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(23 23 27 / 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.9);
    font-size: 0.85rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
</style>
