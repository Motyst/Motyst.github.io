---
/**
 * Design lab: a temporary, unlisted page comparing the live design with
 * new ideas side by side. Not linked anywhere, excluded from search/sitemap.
 *
 * Click an option to choose it, add comments, then copy the generated reply
 * into the chat. For the next round, bump `round`, update `applied` and swap
 * the <Question> blocks.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import ProjectIcon from '@/components/ProjectIcon.astro';
import Question from '@/components/lab/Question.astro';
import Choice from '@/components/lab/Choice.astro';
import { profile } from '@/data/profile';
import { getProjects, groupSkills } from '@/lib/projects';
import { skillIcon, groupStyle } from '@/data/ui-icons';
import { stepColors } from '@/data/step-icons';

const round = 3;
const applied = ['“Email me” + copy button', 'Colour glow background'];

const all = await getProjects();
const four = all.slice(0, 4);
const two = all.slice(0, 2);
const pub = all.find((p) => p.id === 'publishing-automation') ?? all[0];
const steps = pub.data.workflow;
const groups = groupSkills(all);
const openSource = all.filter((p) => p.data.links.some((l) => l.kind === 'repo')).length;

const short: Record<string, string> = {
  'mental-training-bot': 'Memory',
  'publishing-automation': 'Publishing',
  'ai-research-bot': 'Research',
  'video-to-x-posts': 'YouTube → X',
  'polymarket-guardian': 'Guardian',
};

const headlines = {
  a: 'I build AI bots and automations that take repetitive work off people’s plates.',
  b: 'I turn repetitive work into bots and AI pipelines that run on their own.',
};

// Hero cluster mock: scattered (current) and orbit (idea A) positions
const scatter = [
  { x: 12, y: 8, s: 44 },
  { x: 48, y: 2, s: 36 },
  { x: 38, y: 40, s: 52 },
  { x: 6, y: 58, s: 34 },
  { x: 70, y: 46, s: 40 },
];
const orbit = all.slice(0, 5).map((p, i, arr) => {
  const a = (i / arr.length) * Math.PI * 2 - Math.PI / 2;
  return { p, x: 50 + Math.cos(a) * 36, y: 50 + Math.sin(a) * 36 };
});
---

<Base title="Design lab" noindex>
  <div class="container lab" data-round={round}>
    <header class="intro">
      <span class="eyebrow">Design lab · round {round}</span>
      <h1>Pick what you like</h1>
      <ol class="how">
        <li>Click an option to choose it</li>
        <li>Add a comment if you want</li>
        <li>Copy the reply and paste it into the chat</li>
      </ol>
      <p class="applied">
        <span>Applied from round {round - 1}:</span>
        {applied.map((a) => <em><Icon name="check" size={13} /> {a}</em>)}
      </p>
      <p class="hint">
        Every part of the page, top to bottom. “Current” is what’s live now; skip anything you’re happy with.
      </p>
    </header>

    <!-- ───────────── Top of the page ───────────── -->
    <h2 class="part">Top of the page</h2>

    <Question n={1} title="Navigation pill" why="The pill is live. These are small upgrades to it.">
      <Choice label="Current" name="Plain pill" note="Section links, hides on scroll down.">
        <div class="frame">
          <div class="nav-pill"><span class="av">AV</span><span>Work</span><span>Skills</span><span>About</span></div>
          <div class="stub"><p class="k">AI Automation Developer · Dublin</p><p class="n">{profile.name}.</p></div>
        </div>
      </Choice>
      <Choice label="A" name="Highlights where you are" note="The section you’re reading lights up in the pill as you scroll." mine>
        <div class="frame">
          <div class="nav-pill"><span class="av">AV</span><span class="on">Work</span><span>Skills</span><span>About</span></div>
          <div class="stub"><p class="k">Selected work · 5 projects</p><p class="n">Things I've built</p></div>
        </div>
      </Choice>
      <Choice label="B" name="Bottom on phones" note="On phones the pill sits at the bottom, within thumb reach. Desktop stays the same.">
        <div class="frame phone-frame">
          <div class="stub top"><p class="k">AI Automation Developer</p><p class="n sm">{profile.name}.</p></div>
          <div class="nav-pill bottom"><span class="av">AV</span><span>Work</span><span>Skills</span><span>About</span></div>
        </div>
      </Choice>
    </Question>

    <Question n={2} title="Role line above your name" why="“AI Automation Developer · Dublin” is small grey text right now. It is the main thing you want people to remember.">
      <Choice label="Current" name="Small mono caps" note="Quiet and techy. Easy to skip over.">
        <div class="frame">
          <div class="stub"><p class="k">AI Automation Developer · Dublin</p><p class="n">{profile.name}.</p></div>
        </div>
      </Choice>
      <Choice label="A" name="Role chip" note="The role in a small pill with an icon. Stands out without shouting." mine>
        <div class="frame">
          <div class="stub">
            <span class="role-chip"><Icon name="sparkles" size={11} /> AI Automation Developer <i>·</i> Dublin</span>
            <p class="n">{profile.name}.</p>
          </div>
        </div>
      </Choice>
      <Choice label="B" name="Role as a subtitle" note="Name first, then the role in larger gradient text underneath.">
        <div class="frame">
          <div class="stub">
            <p class="n">{profile.name}.</p>
            <p class="role-sub">AI Automation Developer</p>
          </div>
        </div>
      </Choice>
    </Question>

    <Question n={3} title="Your name" why="The biggest thing on the page. A small touch can make it feel less plain.">
      <Choice label="Current" name="White + blue dot" note="Clean and simple.">
        <div class="frame name-frame"><p class="big">{profile.name}<span class="dot">.</span></p></div>
      </Choice>
      <Choice label="A" name="Soft gradient" note="The name fades gently from white to grey. Subtle depth." mine>
        <div class="frame name-frame"><p class="big grad">{profile.name}<span class="dot">.</span></p></div>
      </Choice>
      <Choice label="B" name="Colour-changing dot" note="The dot slowly cycles through the project colours. A tiny living detail.">
        <div class="frame name-frame"><p class="big">{profile.name}<span class="dot cycle">.</span></p></div>
      </Choice>
    </Question>

    <Question n={4} title="Headline under your name" why="The first sentence people read. It could say more about the value, not just the tech.">
      <Choice label="Current" name="What I build" note="Accurate and neutral. Lists the kinds of things you make.">
        <div class="frame head"><p class="n">{profile.name}.</p><p class="lead">{profile.headline}</p></div>
      </Choice>
      <Choice label="A" name="Who it helps" note="Puts the people who use your bots first.">
        <div class="frame head"><p class="n">{profile.name}.</p><p class="lead">{headlines.a}</p></div>
      </Choice>
      <Choice label="B" name="What it replaces" note="Short and outcome-first: manual work in, running system out." mine>
        <div class="frame head"><p class="n">{profile.name}.</p><p class="lead">{headlines.b}</p></div>
      </Choice>
    </Question>

    <Question n={5} title="Your photo" why="A face makes a portfolio feel personal and builds trust. You would send me a photo.">
      <Choice label="Current" name="No photo" note="All about the work. Clean, but a bit anonymous.">
        <div class="frame about">
          <div class="txt"><p class="k">About</p><p class="h">A bit about me</p><i></i><i></i><i class="short"></i></div>
        </div>
      </Choice>
      <Choice label="A" name="Photo in About" note="A round photo next to your bio. The top of the page stays about the projects." mine>
        <div class="frame about">
          <span class="avatar big"><Icon name="user-check" size={26} /></span>
          <div class="txt"><p class="k">About</p><p class="h">A bit about me</p><i></i><i></i><i class="short"></i></div>
        </div>
      </Choice>
      <Choice label="B" name="Photo in the hero" note="A small photo right above your name. Personal from the first second.">
        <div class="frame">
          <div class="stub">
            <span class="avatar"><Icon name="user-check" size={16} /></span>
            <p class="k">AI Automation Developer · Dublin</p>
            <p class="n">{profile.name}.</p>
          </div>
        </div>
      </Choice>
    </Question>

    <Question n={6} title="Project icons next to your name" why="The floating icons are the most eye-catching part of the page. They could be arranged differently.">
      <Choice label="Current" name="Loose cloud" note="Hand-placed icons gently bobbing. Playful.">
        <div class="frame tall">
          {all.slice(0, 5).map((p, i) => (
            <span class="fl" style={`left:${scatter[i].x}%;top:${scatter[i].y}%;--i:${i}`}>
              <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={scatter[i].s} />
            </span>
          ))}
        </div>
      </Choice>
      <Choice label="A" name="Slow orbit" note="Icons circle slowly around a soft glow, like parts of one system." mine>
        <div class="frame tall">
          <span class="core"></span>
          <div class="orbit">
            {orbit.map(({ p, x, y }) => (
              <span class="orb" style={`left:${x}%;top:${y}%`}>
                <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={38} />
              </span>
            ))}
          </div>
        </div>
      </Choice>
      <Choice label="B" name="Tidy app grid" note="A neat grid with names under each icon, like a phone home screen.">
        <div class="frame tall appgrid">
          {all.slice(0, 5).map((p) => (
            <span>
              <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={38} />
              <small>{short[p.id] ?? p.data.title}</small>
            </span>
          ))}
        </div>
      </Choice>
    </Question>

    <!-- ───────────── Projects ───────────── -->
    <h2 class="part">Projects</h2>

    <Question n={7} title="Projects heading" why="The heading above the tiles. Could be shorter, or say a bit more.">
      <Choice label="Current" name="Heading + side text" note="Label, big heading and a hint to tap a project.">
        <div class="frame sec">
          <p class="k">Selected work · {all.length} projects</p>
          <p class="h2">Things I've built</p>
          <p class="side">Tap a project to see how it works.</p>
        </div>
      </Choice>
      <Choice label="A" name="Short + count" note="Just “Projects” with a count. Minimal, less text to read.">
        <div class="frame sec">
          <p class="h2">Projects <span class="count">{all.length}</span></p>
        </div>
      </Choice>
      <Choice label="B" name="Heading + quick facts" note="The heading plus a line of facts with icons. Useful at a glance." mine>
        <div class="frame sec">
          <p class="h2">Things I've built</p>
          <p class="facts">
            <span><Icon name="bot" size={12} /> {all.length} projects</span>
            <span><Icon name="github" size={12} /> {openSource} open source</span>
            <span><Icon name="python" size={12} /> Python & TypeScript</span>
          </p>
        </div>
      </Choice>
    </Question>

    <Question n={8} title="Project tiles" why="Each tile shows an icon, title and one line. It could also hint at how it works.">
      <Choice label="Current" name="Icon + line" note="Clean and fast to scan.">
        <ul class="mtiles">
          {two.map((p) => (
            <li style={`--c:${p.data.accent}`}>
              <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={34} />
              <span><b>{p.data.title}</b><small>{p.data.summary}</small></span>
            </li>
          ))}
        </ul>
      </Choice>
      <Choice label="A" name="+ tech icons" note="A row of small logos for the main tools used (Python, Telegram…).">
        <ul class="mtiles">
          {two.map((p) => (
            <li style={`--c:${p.data.accent}`}>
              <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={34} />
              <span>
                <b>{p.data.title}</b><small>{p.data.summary}</small>
                <em class="tech">
                  {p.data.skills.filter((s) => skillIcon[s]).slice(0, 4).map((s) => <Icon name={skillIcon[s]} size={12} />)}
                </em>
              </span>
            </li>
          ))}
        </ul>
      </Choice>
      <Choice label="B" name="+ mini workflow" note="The workflow step icons in a row: you see how it works before opening it." mine>
        <ul class="mtiles">
          {two.map((p) => (
            <li style={`--c:${p.data.accent}`}>
              <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={34} />
              <span>
                <b>{p.data.title}</b><small>{p.data.summary}</small>
                <em class="flow">
                  {p.data.workflow.map((w, i) => (
                    <>
                      {i > 0 && <i>›</i>}
                      <span style={`--s:${stepColors[i % stepColors.length]}`}>{w.icon && <Icon name={w.icon} size={10} />}</span>
                    </>
                  ))}
                </em>
              </span>
            </li>
          ))}
        </ul>
      </Choice>
    </Question>

    <Question n={9} title="Projects on phones" why="On phones the tiles are two columns, so the longer one-liners wrap into narrow blocks.">
      <Choice label="Current" name="Two columns" note="App-style grid. Icons are big, but text gets squeezed.">
        <div class="phone">
          <ul class="grid2">
            {four.map((p) => (
              <li><ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={24} /><b>{p.data.title}</b><small>{p.data.summary}</small></li>
            ))}
          </ul>
        </div>
      </Choice>
      <Choice label="A" name="One-column rows" note="Icon on the left, the full line on the right. Easier to read, a bit shorter overall." mine>
        <div class="phone">
          <ul class="rows">
            {four.map((p) => (
              <li><ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={26} /><span><b>{p.data.title}</b><small>{p.data.summary}</small></span></li>
            ))}
          </ul>
        </div>
      </Choice>
    </Question>

    <!-- ───────────── Project window ───────────── -->
    <h2 class="part">Project window</h2>

    <Question n={10} title="Top of the project window" why="Until screenshots arrive, the window shows a big icon with rings. That space could work harder.">
      <Choice label="Current" name="Icon banner" note="The project icon with ripple rings. Pretty, but says nothing new.">
        <div class="win" style={`--c:${pub.data.accent}`}>
          <div class="win-h"><ProjectIcon icon={pub.data.icon} title={pub.data.title} accent={pub.data.accent} size={20} /><b>{pub.data.title}</b></div>
          <p class="win-t">{pub.data.tagline}</p>
          <div class="banner"><span class="ring"></span><span class="ring r2"></span><ProjectIcon icon={pub.data.icon} title={pub.data.title} accent={pub.data.accent} size={40} /></div>
        </div>
      </Choice>
      <Choice label="A" name="Live workflow banner" note="The banner shows the workflow with a dot travelling through the steps. Explains the project in two seconds." mine>
        <div class="win" style={`--c:${pub.data.accent}`}>
          <div class="win-h"><ProjectIcon icon={pub.data.icon} title={pub.data.title} accent={pub.data.accent} size={20} /><b>{pub.data.title}</b></div>
          <p class="win-t">{pub.data.tagline}</p>
          <div class="banner flowbanner">
            <span class="track"><i class="runner"></i></span>
            {steps.map((w, i) => (
              <span class="fstep" style={`--s:${stepColors[i % stepColors.length]}`}>{w.icon && <Icon name={w.icon} size={13} />}</span>
            ))}
          </div>
        </div>
      </Choice>
      <Choice label="B" name="No banner" note="Skip the banner until there are screenshots. The window starts straight with links and “How it works”.">
        <div class="win" style={`--c:${pub.data.accent}`}>
          <div class="win-h"><ProjectIcon icon={pub.data.icon} title={pub.data.title} accent={pub.data.accent} size={20} /><b>{pub.data.title}</b></div>
          <p class="win-t">{pub.data.tagline}</p>
          <p class="win-sub">How it works</p>
          <div class="mini-pipe">
            {steps.map((w, i) => (
              <span style={`--s:${stepColors[i % stepColors.length]}`}>{w.icon && <Icon name={w.icon} size={11} />}</span>
            ))}
          </div>
          <i class="bar-l"></i><i class="bar-l short"></i>
        </div>
      </Choice>
    </Question>

    <Question n={11} title="“How it works” steps" why="The workflow is the clearest part of each project. Three ways to lay it out.">
      <Choice label="Current" name="Horizontal pipeline" note="Coloured icons joined by arrows, with a short text under each.">
        <div class="frame pipe-h">
          {steps.map((w, i) => (
            <span class="ph" style={`--s:${stepColors[i % stepColors.length]}`}>
              <i>{w.icon && <Icon name={w.icon} size={13} />}</i>
              <b>{w.title}</b>
              <small></small>
            </span>
          ))}
        </div>
      </Choice>
      <Choice label="A" name="Numbered timeline" note="Steps top to bottom with numbers. Reads like a story, but takes more height.">
        <div class="frame pipe-v">
          {steps.slice(0, 4).map((w, i) => (
            <span class="pv" style={`--s:${stepColors[i % stepColors.length]}`}>
              <i>{i + 1}</i>
              <span><b>{w.title}</b><small>{w.description}</small></span>
            </span>
          ))}
        </div>
      </Choice>
      <Choice label="B" name="Compact row, tap for details" note="Just icons and titles in one row. Tap a step to read its description. Shortest." mine>
        <div class="frame pipe-c">
          <div class="pc-row">
            {steps.map((w, i) => (
              <>
                {i > 0 && <em>→</em>}
                <span class:list={['pc', { sel: i === 1 }]} style={`--s:${stepColors[i % stepColors.length]}`}>
                  <i>{w.icon && <Icon name={w.icon} size={12} />}</i>
                  <b>{w.title}</b>
                </span>
              </>
            ))}
          </div>
          <p class="pc-desc" style={`--s:${stepColors[1]}`}>{steps[1]?.description}</p>
        </div>
      </Choice>
    </Question>

    <Question n={12} title="Switching projects (window footer)" why="The bar at the bottom of the window: previous, all icons, next.">
      <Choice label="Current" name="Prev · icons · next" note="Names of the neighbours plus a dock of all icons. Complete, a bit busy.">
        <div class="frame foot-m">
          <span class="fn">← <ProjectIcon icon={all[4].data.icon} title="" accent={all[4].data.accent} size={16} /> <small>{all[4].data.title.split(' ')[0]}</small></span>
          <span class="dock">{all.map((p, i) => <span class:list={{ on: i === 0 }}><ProjectIcon icon={p.data.icon} title="" accent={p.data.accent} size={16} /></span>)}</span>
          <span class="fn"><small>{all[1].data.title.split(' ')[0]}</small> <ProjectIcon icon={all[1].data.icon} title="" accent={all[1].data.accent} size={16} /> →</span>
        </div>
      </Choice>
      <Choice label="A" name="Icons only" note="Just the dock, a bit bigger, centred. Arrow keys still work." mine>
        <div class="frame foot-m center">
          <span class="dock big">{all.map((p, i) => <span class:list={{ on: i === 0 }}><ProjectIcon icon={p.data.icon} title="" accent={p.data.accent} size={22} /></span>)}</span>
        </div>
      </Choice>
      <Choice label="B" name="Next project card" note="One big “Next: Publishing Automation →” button. Guides people through the projects in order.">
        <div class="frame foot-m center">
          <span class="nextcard">
            <small>Next</small>
            <ProjectIcon icon={all[1].data.icon} title="" accent={all[1].data.accent} size={20} />
            <b>{all[1].data.title}</b> →
          </span>
        </div>
      </Choice>
    </Question>

    <!-- ───────────── Skills & About ───────────── -->
    <h2 class="part">Skills and About</h2>

    <Question n={13} title="Skills section" why="Four cards with chips right now. Could be more compact or more visual.">
      <Choice label="Current" name="Four cards" note="A card per group, each with a coloured icon and chips.">
        <div class="sk-cards">
          {groups.map((g) => {
            const st = groupStyle[g.category];
            return (
              <div style={`--g:${st?.color}`}>
                <b><i><Icon name={st?.icon ?? 'sparkles'} size={10} /></i>{g.category}</b>
                <p>{g.skills.slice(0, 4).map((s) => <span>{s.name}</span>)}</p>
              </div>
            );
          })}
        </div>
      </Choice>
      <Choice label="A" name="One panel, four rows" note="One box, each group on its own row. Tighter, less scrolling on phones." mine>
        <div class="sk-rows">
          {groups.map((g) => {
            const st = groupStyle[g.category];
            return (
              <div style={`--g:${st?.color}`}>
                <b><i><Icon name={st?.icon ?? 'sparkles'} size={10} /></i>{g.category}</b>
                <p>{g.skills.slice(0, 3).map((s) => <span>{s.name}</span>)}</p>
              </div>
            );
          })}
        </div>
      </Choice>
      <Choice label="B" name="Logo wall" note="A grid of tool logos with names, coloured by group. Most visual, least text.">
        <div class="sk-wall">
          {groups.flatMap((g) =>
            g.skills
              .filter((s) => skillIcon[s.name])
              .slice(0, 3)
              .map((s) => (
                <span style={`--g:${groupStyle[g.category]?.color}`}>
                  <Icon name={skillIcon[s.name]} size={15} />
                  <small>{s.name}</small>
                </span>
              )),
          )}
        </div>
      </Choice>
    </Question>

    <Question n={14} title="About section" why="Two paragraphs and a list of facts. Could be easier to skim.">
      <Choice label="Current" name="Bio + facts list" note="Text first, then “Based in” and “Speaks”.">
        <div class="frame about2">
          <p class="h">A bit about me</p>
          <i></i><i></i><i class="short"></i>
          <p class="fl2"><span>Based in <b>Dublin</b></span><span>Speaks <b>LV · RU · EN</b></span></p>
        </div>
      </Choice>
      <Choice label="A" name="Bio + fact cards" note="The facts as three small cards with icons. Quick to skim.">
        <div class="frame about2">
          <p class="h">A bit about me</p>
          <i></i><i class="short"></i>
          <div class="fcards">
            <span><Icon name="globe" size={12} /><b>Dublin</b><small>Based in</small></span>
            <span><Icon name="message-square-text" size={12} /><b>3 languages</b><small>LV · RU · EN</small></span>
            <span><Icon name="calendar-clock" size={12} /><b>Jan 2026</b><small>Building since</small></span>
          </div>
        </div>
      </Choice>
      <Choice label="B" name="Bio + how I work" note="One short paragraph plus three principles with icons. Says how you think, not only where you are." mine>
        <div class="frame about2">
          <p class="h">A bit about me</p>
          <i class="short"></i>
          <div class="princ">
            <span style="--s:#34d399"><i><Icon name="user-check" size={12} /></i><b>Human in the loop</b></span>
            <span style="--s:#7c9cff"><i><Icon name="server" size={12} /></i><b>Built for production</b></span>
            <span style="--s:#fbbf24"><i><Icon name="zap" size={12} /></i><b>Automate the boring part</b></span>
          </div>
        </div>
      </Choice>
    </Question>

    <!-- ───────────── Footer ───────────── -->
    <h2 class="part">Bottom of the page</h2>

    <Question n={15} title="Footer" why="Just a copyright line at the moment.">
      <Choice label="Current" name="Copyright only" note="As minimal as it gets.">
        <div class="frame foot2"><span>© 2026 {profile.name}</span></div>
      </Choice>
      <Choice label="A" name="+ back to top" note="A small “Back to top ↑” link on the right. Handy on phones." mine>
