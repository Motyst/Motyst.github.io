---
/**
 * Design lab: a temporary, unlisted page comparing the live design with
 * new ideas side by side. Not linked anywhere, excluded from search/sitemap.
 *
 * Click an option to choose it, add comments, then copy the generated reply
 * into the chat. For the next round, bump `round`, update `applied` and swap
 * the <Question> blocks.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Question from '@/components/lab/Question.astro';
import Choice from '@/components/lab/Choice.astro';
import PreviewDialog from '@/components/lab/PreviewDialog.astro';
import ProjectIcon from '@/components/ProjectIcon.astro';
import { getProjects } from '@/lib/projects';

const round = 8;
const applied: string[] = [];
const projects = await getProjects();
const sketch = [
  { id: 'current', label: 'Current', name: 'Last row stretches', preview: '/', note: 'Three per row. With 7 projects the last one fills the whole row, so it looks bigger and more important than the rest.' },
  { id: 'grid-centred', label: 'A', name: 'Same size, last row centred', mine: true, note: 'Every tile is the same size and a short last row sits in the middle. Works for any number of projects, so nothing to rethink when you add one.' },
  { id: 'grid-bento', label: 'B', name: 'Bento with featured projects', note: 'Projects marked featured (Mental Training Bot, Publishing Automation) get a wide tile with their full tagline. Fits 7 exactly; other counts may need a tweak.' },
  { id: 'grid-list', label: 'C', name: 'One per row list', note: 'A clean index: title and summary on one line. Scales to any number and reads fastest, but the page gets longer and less visual.' },
];
---

<Base title="Design lab" noindex>
  <div class="container lab" data-round={round}>
    <header class="intro">
      <span class="eyebrow">Design lab · round {round}</span>
      <h1>Pick what you like</h1>
      <ol class="how">
        <li>Click an option to choose it</li>
        <li>Double-click it (or press <b>Full page</b>) to see the whole page, on desktop and mobile</li>
        <li>Add a comment if you want</li>
        <li>Copy the reply and paste it into the chat</li>
      </ol>
      {applied.length > 0 && <p class="applied">
        <span>Applied from round {round - 1}:</span>
        {applied.map((a) => <em><Icon name="check" size={13} /> {a}</em>)}
      </p>}
    </header>

    <p class="empty">
      No open questions right now. Ask for new ideas in the chat and they will show up here as{' '}
      <b>Current / A / B</b> cards to choose from.
    </p>

    <Question n={1} title="Project grid with 7 projects" anchor="work" why="Three tiles per row leaves one project alone on the last row, stretched across the full width.">
      {
        sketch.map((o) => (
          <Choice label={o.label} name={o.name} note={o.note} mine={o.mine} preview={o.id === 'current' ? '/' : `/lab/preview/${o.id}/`}>
            <ul class={`sk sk-${o.id}`}>
              {projects.map((p) => (
                <li class:list={{ feat: p.data.featured }} style={`--c:${p.data.accent}`}>
                  <ProjectIcon icon={p.data.icon} title={p.data.title} accent={p.data.accent} size={o.id === 'grid-list' ? 18 : 22} />
                  <span>
                    <b>{p.data.title}</b>
                    {(o.id === 'grid-list' || (o.id === 'grid-bento' && p.data.featured)) && <small>{o.id === 'grid-bento' ? p.data.tagline : p.data.summary}</small>}
                  </span>
                </li>
              ))}
            </ul>
          </Choice>
        ))
      }
    </Question>

    <section class="reply">
      <h2>Your reply</h2>
      <textarea data-overall rows="2" placeholder="Anything else? Other ideas, things you'd like to see compared next…"></textarea>
      <pre data-out></pre>
      <button type="button" class="copy-btn" data-copy-reply>
        <Icon name="copy" size={16} /> <span>Copy reply</span>
      </button>
    </section>

    <PreviewDialog />

    <div class="bar">
      <span data-count></span>
      <button type="button" class="copy-btn" data-copy-reply>
        <Icon name="copy" size={16} /> <span>Copy reply</span>
      </button>
    </div>
  </div>
</Base>

<script>
  function initLab() {
    const lab = document.querySelector<HTMLElement>('.lab[data-round]');
    if (!lab) return;
    const key = `design-lab-${lab.dataset.round}`;
    const questions = [...lab.querySelectorAll<HTMLElement>('[data-q]')];
    const overall = lab.querySelector<HTMLTextAreaElement>('[data-overall]')!;
    const out = lab.querySelector<HTMLElement>('[data-out]')!;
    const count = lab.querySelector<HTMLElement>('[data-count]')!;

    const build = () => {
      const lines = [`Design lab round ${lab.dataset.round} picks:`];
      let picked = 0;
      questions.forEach((q) => {
        const c = q.querySelector<HTMLElement>('.opt.chosen');
        const note = q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value.trim();
        if (c) picked++;
        // Only list questions with a pick or a comment; the rest stay as they are.
        if (!c && !note) return;
        lines.push(`${q.dataset.n}. ${q.dataset.q}: ${c ? `${c.dataset.label} (${c.dataset.name})` : 'no pick'}`);
        if (note) lines.push(`   Comment: ${note}`);
      });
      if (lines.length === 1) lines.push('(nothing chosen yet)');
      else if (picked < questions.length) lines.push('Everything else: keep current');
      if (overall.value.trim()) lines.push(`Overall: ${overall.value.trim()}`);
      out.textContent = lines.join('\n');
      count.textContent = `${picked} of ${questions.length} chosen`;
      save();
    };

    // Remember picks and comments in this browser (nice to have only).
    const save = () => {
      try {
        const state = questions.map((q) => ({
          q: q.dataset.q,
          pick: q.querySelector<HTMLElement>('.opt.chosen')?.dataset.label ?? null,
          note: q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value,
        }));
        localStorage.setItem(key, JSON.stringify({ state, overall: overall.value }));
      } catch {}
    };
    const choose = (opt: HTMLElement) => {
      const q = opt.closest('[data-q]')!;
      const was = opt.classList.contains('chosen');
      q.querySelectorAll<HTMLElement>('.opt').forEach((o) => {
        o.classList.remove('chosen');
        o.querySelector('[data-choose]')!.setAttribute('aria-pressed', 'false');
      });
      if (!was) {
        opt.classList.add('chosen');
        opt.querySelector('[data-choose]')!.setAttribute('aria-pressed', 'true');
      }
    };

    try {
      const saved = JSON.parse(localStorage.getItem(key) ?? 'null');
      saved?.state?.forEach((s: { q?: string; pick: string | null; note: string }) => {
        const q = questions.find((x) => x.dataset.q === s.q);
        if (!q) return;
        const opt = s.pick && q.querySelector<HTMLElement>(`.opt[data-label="${s.pick}"]`);
        if (opt) choose(opt);
        q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value = s.note ?? '';
      });
      if (saved?.overall) overall.value = saved.overall;
    } catch {}

    lab.querySelectorAll<HTMLElement>('.opt').forEach((opt) =>
      opt.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-full]')) return;
        choose(opt);
        build();
      }),
    );
    lab.addEventListener('input', build);

    lab.querySelectorAll<HTMLButtonElement>('[data-copy-reply]').forEach((b) =>
      b.addEventListener('click', async () => {
        const text = out.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const t = document.createElement('textarea');
          t.value = text;
          t.style.position = 'fixed';
          t.style.opacity = '0';
          document.body.append(t);
          t.select();
          document.execCommand('copy');
          t.remove();
        }
        const label = b.querySelector('span')!;
        b.classList.add('done');
        label.textContent = 'Copied, paste it in the chat';
        setTimeout(() => {
          b.classList.remove('done');
          label.textContent = 'Copy reply';
        }, 2200);
      }),
    );

    build();
  }
  document.addEventListener('astro:page-load', initLab);

  // Real components rendered at desktop width, scaled down to fit a card.
  function fitPreviews() {
    document.querySelectorAll<HTMLElement>('.fit').forEach((box) => {
      const inner = box.firstElementChild as HTMLElement;
      const k = box.clientWidth / inner.offsetWidth;
      inner.style.transform = `scale(${k})`;
      box.style.height = `${inner.offsetHeight * k}px`;
    });
  }
  document.addEventListener('astro:page-load', fitPreviews);
  addEventListener('resize', fitPreviews);
</script>

<style>
  .lab {
    padding-block: clamp(2rem, 5vw, 3rem) 6rem;
  }
  .intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.9rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-dim);
  }
  .how li::marker {
    color: var(--text-faint);
  }
  .applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }
  .applied em {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(34 197 94 / 0.3);
    color: #86efac;
    font-style: normal;
  }
  /* Shown only when there are no questions; the reply and bar only when there are */
  .empty {
    margin-top: 3rem;
    padding: 2rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    color: var(--text-dim);
    text-align: center;
  }
  .empty b {
    color: var(--text);
  }
  .lab:has([data-q]) .empty,
  .lab:not(:has([data-q])) .reply,
  .lab:not(:has([data-q])) .bar {
    display: none;
  }

  /* ---------- Shared mini frame for previews ---------- */
  .frame {
    position: relative;
    height: 150px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background:
      radial-gradient(40% 60% at 10% 0%, rgb(167 139 250 / 0.16), transparent 70%),
      radial-gradient(40% 60% at 90% 0%, rgb(251 113 133 / 0.1), transparent 70%),
      var(--bg);
    overflow: hidden;
  }
  .k {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* Scaled real-component previews */
  .fit {
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-elev);
  }
  .fit-in {
    width: 760px;
    padding: 22px;
    transform-origin: 0 0;
  }

  /* ---------- Mini project grids ---------- */
  .sk {
    list-style: none;
    margin: 0;
    padding: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
  }
  .sk li {
    flex: 1 1 calc((100% - 12px) / 3);
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background:
      radial-gradient(90% 140% at 0% 50%, color-mix(in oklab, var(--c) 12%, transparent), transparent 60%),
      var(--bg-elev);
  }
  .sk li > span {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .sk b {
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.25;
  }
  .sk small {
    font-size: 9.5px;
    color: var(--text-dim);
    line-height: 1.3;
  }
  .sk-grid-centred {
    justify-content: center;
  }
  .sk-grid-centred li {
    flex-grow: 0;
  }
  .sk-grid-bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
  }
  .sk-grid-bento .feat {
    grid-column: span 2;
    padding: 10px;
  }
  .sk-grid-list li {
    flex-basis: 100%;
    padding: 5px 8px;
  }
  .sk-grid-list li > span {
    flex-direction: row;
    align-items: baseline;
    gap: 10px;
  }
  .sk-grid-list b {
    flex: none;
    width: 42%;
  }
  .sk-grid-list small {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------- Reply ---------- */
  .reply {
    margin-top: 4rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }
  .reply h2 {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .reply textarea {
    display: block;
    width: 100%;
    margin-top: 0.9rem;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    resize: vertical;
    field-sizing: content;
    min-height: 4rem;
  }
  .reply textarea:focus {
    outline: none;
    border-color: var(--line-strong);
  }
  pre {
    margin: 0.9rem 0;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: var(--bg);
    border: 1px dashed var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-dim);
    white-space: pre-wrap;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-btn:hover {
    background: #fff;
  }
  .copy-btn.done {
    background: #16a34a;
    color: #fff;
  }

  .bar {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    translate: -50% 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.4rem 0.4rem 0.4rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(23 23 27 / 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.9);
    font-size: 0.85rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
</style>
