---
/**
 * Design lab: a temporary, unlisted page comparing the live design with
 * new ideas side by side. Not linked anywhere, excluded from search/sitemap.
 *
 * Click an option to choose it, add comments, then copy the generated reply
 * into the chat. For the next round, bump `round`, update `applied` and swap
 * the <Question> blocks.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Question from '@/components/lab/Question.astro';
import Choice from '@/components/lab/Choice.astro';
import PreviewDialog from '@/components/lab/PreviewDialog.astro';
import { aboutVariants } from '@/data/lab-variants';
import { profile } from '@/data/profile';

const round = 5;
const applied = ['Fading hairlines between sections'];
---

<Base title="Design lab" noindex>
  <div class="container lab" data-round={round}>
    <header class="intro">
      <span class="eyebrow">Design lab · round {round}</span>
      <h1>Pick what you like</h1>
      <ol class="how">
        <li>Click an option to choose it</li>
        <li>Double-click it (or press <b>Full page</b>) to see the whole page, on desktop and mobile</li>
        <li>Add a comment if you want</li>
        <li>Copy the reply and paste it into the chat</li>
      </ol>
      <p class="applied">
        <span>Applied from round {round - 1}:</span>
        {applied.map((a) => <em><Icon name="check" size={13} /> {a}</em>)}
      </p>
    </header>

    <p class="empty">
      No open questions right now. Ask for new ideas in the chat and they will show up here as{' '}
      <b>Current / A / B</b> cards to choose from.
    </p>

    <!-- Add <Question> / <Choice> blocks here -->
    <Question n={1} title="Your outlook in About" anchor="about" why="Adding how you think: results first, systems thinking, and AI as leverage.">
      <Choice label="Current" name="How I work (3 cards)" note="Bio plus the three practical points that are live now." preview="/">
        <div class="frame ab">
          <p class="t">A bit about me</p><i></i><i class="s"></i>
          <div class="rows">{profile.principles.map((p) => <span style={`--p:${p.color}`}><em></em>{p.title}</span>)}</div>
        </div>
      </Choice>
      <Choice label="A" name="How I think (4 cards)" note="Your outlook as four cards in a 2 × 2 grid: results, systems, AI as leverage, human in the loop." preview="/lab/preview/about-a/">
        <div class="frame ab">
          <p class="t">A bit about me</p><i></i><i class="s"></i>
          <div class="grid4">{aboutVariants['about-a'].principles.map((p) => <span style={`--p:${p.color}`}><em></em>{p.title}</span>)}</div>
        </div>
      </Choice>
      <Choice label="B" name="Statement + 3 cards" note="One bold line about AI as leverage, then three cards. The most personal and memorable." preview="/lab/preview/about-b/" mine>
        <div class="frame ab">
          <p class="t">A bit about me</p><i class="s"></i>
          <p class="q">{aboutVariants['about-b'].quote}</p>
          <div class="rows">{aboutVariants['about-b'].principles.map((p) => <span style={`--p:${p.color}`}><em></em>{p.title}</span>)}</div>
        </div>
      </Choice>
    </Question>

    <section class="reply">
      <h2>Your reply</h2>
      <textarea data-overall rows="2" placeholder="Anything else? Other ideas, things you'd like to see compared next…"></textarea>
      <pre data-out></pre>
      <button type="button" class="copy-btn" data-copy-reply>
        <Icon name="copy" size={16} /> <span>Copy reply</span>
      </button>
    </section>

    <PreviewDialog />

    <div class="bar">
      <span data-count></span>
      <button type="button" class="copy-btn" data-copy-reply>
        <Icon name="copy" size={16} /> <span>Copy reply</span>
      </button>
    </div>
  </div>
</Base>

<script>
  function initLab() {
    const lab = document.querySelector<HTMLElement>('.lab[data-round]');
    if (!lab) return;
    const key = `design-lab-${lab.dataset.round}`;
    const questions = [...lab.querySelectorAll<HTMLElement>('[data-q]')];
    const overall = lab.querySelector<HTMLTextAreaElement>('[data-overall]')!;
    const out = lab.querySelector<HTMLElement>('[data-out]')!;
    const count = lab.querySelector<HTMLElement>('[data-count]')!;

    const build = () => {
      const lines = [`Design lab round ${lab.dataset.round} picks:`];
      let picked = 0;
      questions.forEach((q) => {
        const c = q.querySelector<HTMLElement>('.opt.chosen');
        const note = q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value.trim();
        if (c) picked++;
        // Only list questions with a pick or a comment; the rest stay as they are.
        if (!c && !note) return;
        lines.push(`${q.dataset.n}. ${q.dataset.q}: ${c ? `${c.dataset.label} (${c.dataset.name})` : 'no pick'}`);
        if (note) lines.push(`   Comment: ${note}`);
      });
      if (lines.length === 1) lines.push('(nothing chosen yet)');
      else if (picked < questions.length) lines.push('Everything else: keep current');
      if (overall.value.trim()) lines.push(`Overall: ${overall.value.trim()}`);
      out.textContent = lines.join('\n');
      count.textContent = `${picked} of ${questions.length} chosen`;
      save();
    };

    // Remember picks and comments in this browser (nice to have only).
    const save = () => {
      try {
        const state = questions.map((q) => ({
          q: q.dataset.q,
          pick: q.querySelector<HTMLElement>('.opt.chosen')?.dataset.label ?? null,
          note: q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value,
        }));
        localStorage.setItem(key, JSON.stringify({ state, overall: overall.value }));
      } catch {}
    };
    const choose = (opt: HTMLElement) => {
      const q = opt.closest('[data-q]')!;
      const was = opt.classList.contains('chosen');
      q.querySelectorAll<HTMLElement>('.opt').forEach((o) => {
        o.classList.remove('chosen');
        o.querySelector('[data-choose]')!.setAttribute('aria-pressed', 'false');
      });
      if (!was) {
        opt.classList.add('chosen');
        opt.querySelector('[data-choose]')!.setAttribute('aria-pressed', 'true');
      }
    };

    try {
      const saved = JSON.parse(localStorage.getItem(key) ?? 'null');
      saved?.state?.forEach((s: { q?: string; pick: string | null; note: string }) => {
        const q = questions.find((x) => x.dataset.q === s.q);
        if (!q) return;
        const opt = s.pick && q.querySelector<HTMLElement>(`.opt[data-label="${s.pick}"]`);
        if (opt) choose(opt);
        q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value = s.note ?? '';
      });
      if (saved?.overall) overall.value = saved.overall;
    } catch {}

    lab.querySelectorAll<HTMLElement>('.opt').forEach((opt) =>
      opt.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-full]')) return;
        choose(opt);
        build();
      }),
    );
    lab.addEventListener('input', build);

    lab.querySelectorAll<HTMLButtonElement>('[data-copy-reply]').forEach((b) =>
      b.addEventListener('click', async () => {
        const text = out.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const t = document.createElement('textarea');
          t.value = text;
          t.style.position = 'fixed';
          t.style.opacity = '0';
          document.body.append(t);
          t.select();
          document.execCommand('copy');
          t.remove();
        }
        const label = b.querySelector('span')!;
        b.classList.add('done');
        label.textContent = 'Copied, paste it in the chat';
        setTimeout(() => {
          b.classList.remove('done');
          label.textContent = 'Copy reply';
        }, 2200);
      }),
    );

    build();
  }
  document.addEventListener('astro:page-load', initLab);
</script>

<style>
  .lab {
    padding-block: clamp(2rem, 5vw, 3rem) 6rem;
  }
  .intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.9rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-dim);
  }
  .how li::marker {
    color: var(--text-faint);
  }
  .applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }
  .applied em {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(34 197 94 / 0.3);
    color: #86efac;
    font-style: normal;
  }
  /* Shown only when there are no questions; the reply and bar only when there are */
  .empty {
    margin-top: 3rem;
    padding: 2rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    color: var(--text-dim);
    text-align: center;
  }
  .empty b {
    color: var(--text);
  }
  .lab:has([data-q]) .empty,
  .lab:not(:has([data-q])) .reply,
  .lab:not(:has([data-q])) .bar {
    display: none;
  }

  /* ---------- Shared mini frame for previews ---------- */
  .frame {
    position: relative;
    height: 150px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background:
      radial-gradient(40% 60% at 10% 0%, rgb(167 139 250 / 0.16), transparent 70%),
      radial-gradient(40% 60% at 90% 0%, rgb(251 113 133 / 0.1), transparent 70%),
      var(--bg);
    overflow: hidden;
  }
  .k {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* About previews */
  .frame.ab {
    height: 200px;
    padding: 12px 14px;
  }
  .ab .t {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .ab > i {
    display: block;
    height: 5px;
    margin-top: 5px;
    border-radius: 4px;
    background: var(--bg-soft);
  }
  .ab > i.s {
    width: 60%;
  }
  .ab .q {
    margin-top: 8px;
    padding-left: 8px;
    border-left: 2px solid #a78bfa;
    font-size: 10px;
    line-height: 1.4;
    color: var(--text);
  }
  .ab .rows,
  .ab .grid4 {
    display: grid;
    gap: 4px;
    margin-top: 10px;
  }
  .ab .grid4 {
    grid-template-columns: 1fr 1fr;
  }
  .ab .rows span,
  .ab .grid4 span {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 7px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--bg-elev);
    font-size: 9.5px;
    font-weight: 500;
  }
  .ab em {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 4px;
    background: color-mix(in oklab, var(--p) 40%, transparent);
    border: 1px solid var(--p);
  }

  /* ---------- Reply ---------- */
  .reply {
    margin-top: 4rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }
  .reply h2 {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .reply textarea {
    display: block;
    width: 100%;
    margin-top: 0.9rem;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    resize: vertical;
    field-sizing: content;
    min-height: 4rem;
  }
  .reply textarea:focus {
    outline: none;
    border-color: var(--line-strong);
  }
  pre {
    margin: 0.9rem 0;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: var(--bg);
    border: 1px dashed var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-dim);
    white-space: pre-wrap;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-btn:hover {
    background: #fff;
  }
  .copy-btn.done {
    background: #16a34a;
    color: #fff;
  }

  .bar {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    translate: -50% 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.4rem 0.4rem 0.4rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(23 23 27 / 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.9);
    font-size: 0.85rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
</style>
