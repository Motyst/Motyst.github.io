---
/**
 * Design lab: a temporary, unlisted page comparing the live design with
 * new ideas side by side. Not linked anywhere, excluded from search/sitemap.
 *
 * Click an option to choose it, add comments, then copy the generated reply
 * into the chat. For the next round, bump `round`, update `applied` and swap
 * the <Question> blocks.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Question from '@/components/lab/Question.astro';
import Choice from '@/components/lab/Choice.astro';
import { profile } from '@/data/profile';

const round = 2;
const applied = ['Floating pill nav', 'Copyable email chip', 'What + result one-liners', 'GitHub and email in one place'];
---

<Base title="Design lab" noindex>
  <div class="container lab" data-round={round}>
    <header class="intro">
      <span class="eyebrow">Design lab · round {round}</span>
      <h1>Pick what you like</h1>
      <ol class="how">
        <li>Click an option to choose it</li>
        <li>Add a comment if you want</li>
        <li>Copy the reply and paste it into the chat</li>
      </ol>
      <p class="applied">
        <span>Applied from round {round - 1}:</span>
        {applied.map((a) => <em><Icon name="check" size={13} /> {a}</em>)}
      </p>
    </header>

    <Question n={1} title="Email button text" why="Showing the address is handy, but it is also the part people may not want on display.">
      <Choice label="Current" name="Full address" note="The address is readable at a glance. Click copies it." mine>
        <div class="frame btns">
          <span class="mbtn primary">See my work <Icon name="arrow-down" size={13} /></span>
          <span class="mchip"><Icon name="mail" size={13} /> {profile.email} <i><Icon name="copy" size={11} /></i></span>
          <span class="mround"><Icon name="github" size={14} /></span>
        </div>
      </Choice>
      <Choice label="A" name="“Copy email” label" note="Shorter and tidier. The address only appears in the “Copied” message.">
        <div class="frame btns">
          <span class="mbtn primary">See my work <Icon name="arrow-down" size={13} /></span>
          <span class="mchip"><Icon name="mail" size={13} /> Copy email <i><Icon name="copy" size={11} /></i></span>
          <span class="mround"><Icon name="github" size={14} /></span>
        </div>
      </Choice>
      <Choice label="B" name="Email me + copy" note="Two halves: the text opens the mail app, the icon copies the address.">
        <div class="frame btns">
          <span class="mbtn primary">See my work <Icon name="arrow-down" size={13} /></span>
          <span class="msplit"><span><Icon name="mail" size={13} /> Email me</span><i><Icon name="copy" size={11} /></i></span>
          <span class="mround"><Icon name="github" size={14} /></span>
        </div>
      </Choice>
    </Question>

    <Question n={2} title="Page background" why="The page is plain dark. A little colour at the top could make it feel less empty.">
      <Choice label="Current" name="Plain dark" note="Calm and neutral. The project icons carry all the colour.">
        <div class="frame bg-cur">
          <div class="stub"><p class="k">AI Automation Developer · Dublin</p><p class="n">{profile.name}.</p></div>
        </div>
      </Choice>
      <Choice label="A" name="Colour glow" note="A soft glow in the project colours behind the top of the page, fading out as you scroll." mine>
        <div class="frame bg-a">
          <div class="stub"><p class="k">AI Automation Developer · Dublin</p><p class="n">{profile.name}.</p></div>
        </div>
      </Choice>
      <Choice label="B" name="Dot grid" note="A faint technical dot grid that fades out. Structured, a bit “developer”.">
        <div class="frame bg-b">
          <div class="stub"><p class="k">AI Automation Developer · Dublin</p><p class="n">{profile.name}.</p></div>
        </div>
      </Choice>
    </Question>

    <section class="reply">
      <h2>Your reply</h2>
      <textarea data-overall rows="2" placeholder="Anything else? Other ideas, things you'd like to see compared next…"></textarea>
      <pre data-out></pre>
      <button type="button" class="copy-btn" data-copy-reply>
        <Icon name="copy" size={16} /> <span>Copy reply</span>
      </button>
    </section>
  </div>

  <div class="bar">
    <span data-count></span>
    <button type="button" class="copy-btn" data-copy-reply>
      <Icon name="copy" size={16} /> <span>Copy reply</span>
    </button>
  </div>
</Base>

<script>
  function initLab() {
    const lab = document.querySelector<HTMLElement>('.lab[data-round]');
    if (!lab) return;
    const key = `design-lab-${lab.dataset.round}`;
    const questions = [...lab.querySelectorAll<HTMLElement>('[data-q]')];
    const overall = lab.querySelector<HTMLTextAreaElement>('[data-overall]')!;
    const out = lab.querySelector<HTMLElement>('[data-out]')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;

    const build = () => {
      const lines = [`Design lab round ${lab.dataset.round} picks:`];
      let picked = 0;
      questions.forEach((q, i) => {
        const c = q.querySelector<HTMLElement>('.opt.chosen');
        if (c) picked++;
        lines.push(`${i + 1}. ${q.dataset.q}: ${c ? `${c.dataset.label} (${c.dataset.name})` : 'no pick'}`);
        const note = q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value.trim();
        if (note) lines.push(`   Comment: ${note}`);
      });
      if (overall.value.trim()) lines.push(`Overall: ${overall.value.trim()}`);
      out.textContent = lines.join('\n');
      count.textContent = `${picked} of ${questions.length} chosen`;
      save();
    };

    // Remember picks and comments in this browser (nice to have only).
    const save = () => {
      try {
        const state = questions.map((q) => ({
          pick: q.querySelector<HTMLElement>('.opt.chosen')?.dataset.label ?? null,
          note: q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value,
        }));
        localStorage.setItem(key, JSON.stringify({ state, overall: overall.value }));
      } catch {}
    };
    const choose = (opt: HTMLElement) => {
      const q = opt.closest('[data-q]')!;
      const was = opt.classList.contains('chosen');
      q.querySelectorAll<HTMLElement>('.opt').forEach((o) => {
        o.classList.remove('chosen');
        o.querySelector('[data-choose]')!.setAttribute('aria-pressed', 'false');
      });
      if (!was) {
        opt.classList.add('chosen');
        opt.querySelector('[data-choose]')!.setAttribute('aria-pressed', 'true');
      }
    };

    try {
      const saved = JSON.parse(localStorage.getItem(key) ?? 'null');
      saved?.state?.forEach((s: { pick: string | null; note: string }, i: number) => {
        const q = questions[i];
        if (!q) return;
        const opt = s.pick && q.querySelector<HTMLElement>(`.opt[data-label="${s.pick}"]`);
        if (opt) choose(opt);
        q.querySelector<HTMLTextAreaElement>('[data-comment]')!.value = s.note ?? '';
      });
      if (saved?.overall) overall.value = saved.overall;
    } catch {}

    lab.querySelectorAll<HTMLElement>('.opt').forEach((opt) =>
      opt.addEventListener('click', () => {
        choose(opt);
        build();
      }),
    );
    lab.addEventListener('input', build);

    document.querySelectorAll<HTMLButtonElement>('[data-copy-reply]').forEach((b) =>
      b.addEventListener('click', async () => {
        const text = out.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const t = document.createElement('textarea');
          t.value = text;
          t.style.position = 'fixed';
          t.style.opacity = '0';
          document.body.append(t);
          t.select();
          document.execCommand('copy');
          t.remove();
        }
        const label = b.querySelector('span')!;
        b.classList.add('done');
        label.textContent = 'Copied, paste it in the chat';
        setTimeout(() => {
          b.classList.remove('done');
          label.textContent = 'Copy reply';
        }, 2200);
      }),
    );

    build();
  }
  document.addEventListener('astro:page-load', initLab);
</script>

<style>
  .lab {
    padding-block: clamp(2rem, 5vw, 3rem) 6rem;
  }
  .intro h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .how {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.9rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-dim);
  }
  .how li::marker {
    color: var(--text-faint);
  }
  .applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }
  .applied em {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(34 197 94 / 0.3);
    color: #86efac;
    font-style: normal;
  }

  /* Mini page frame */
  .frame {
    position: relative;
    height: 150px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg);
    overflow: hidden;
  }
  .stub {
    position: absolute;
    left: 16px;
    bottom: 22px;
  }
  .stub .k {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .stub .n {
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -0.05em;
    margin-top: 4px;
  }

  /* Background options */
  .bg-cur {
    background:
      radial-gradient(40% 50% at 80% 40%, rgb(124 156 255 / 0.12), transparent),
      var(--bg);
  }
  .bg-a {
    background:
      radial-gradient(45% 55% at 10% 0%, rgb(167 139 250 / 0.28), transparent 70%),
      radial-gradient(40% 50% at 55% -10%, rgb(76 201 240 / 0.22), transparent 70%),
      radial-gradient(40% 50% at 95% 10%, rgb(251 113 133 / 0.2), transparent 70%),
      var(--bg);
  }
  .bg-b {
    background: var(--bg);
  }
  .bg-b::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(rgb(255 255 255 / 0.14) 1px, transparent 1.3px) 0 0 / 14px 14px;
    mask-image: linear-gradient(to bottom, #000, transparent 90%);
  }

  /* Mini hero buttons */
  .frame.btns {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0.8rem;
    font-size: 0.78rem;
  }
  .mbtn,
  .mchip,
  .msplit,
  .mround {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    white-space: nowrap;
  }
  .mbtn {
    padding: 0 0.85rem;
  }
  .mbtn.primary {
    background: var(--text);
    color: var(--bg);
    border-color: transparent;
    font-weight: 500;
  }
  .mchip {
    padding: 0 0.3rem 0 0.75rem;
  }
  .mchip i,
  .msplit i {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--bg-soft);
    color: var(--text-dim);
  }
  .msplit {
    padding: 0 0.3rem 0 0;
  }
  .msplit > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 100%;
    padding: 0 0.6rem 0 0.75rem;
    border-right: 1px solid var(--line-strong);
    margin-right: 0.1rem;
  }
  .mround {
    justify-content: center;
    width: 2.1rem;
    color: var(--text-dim);
  }

  /* Reply */
  .reply {
    margin-top: 4rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
  }
  .reply h2 {
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .reply textarea {
    display: block;
    width: 100%;
    margin-top: 0.9rem;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    resize: vertical;
    field-sizing: content;
    min-height: 4rem;
  }
  .reply textarea:focus {
    outline: none;
    border-color: var(--line-strong);
  }
  pre {
    margin: 0.9rem 0;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: var(--bg);
    border: 1px dashed var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-dim);
    white-space: pre-wrap;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-btn:hover {
    background: #fff;
  }
  .copy-btn.done {
    background: #16a34a;
    color: #fff;
  }

  /* Sticky bar at the bottom of the screen */
  .bar {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    translate: -50% 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.4rem 0.4rem 0.4rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(23 23 27 / 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.9);
    font-size: 0.85rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
</style>
