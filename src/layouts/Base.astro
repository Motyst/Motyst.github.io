---
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { profile } from '@/data/profile';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Share image path. Defaults to /og.png, made with `npm run og`. */
  image?: string;
  /** Keep this page out of search engines (e.g. the design lab). */
  noindex?: boolean;
  /** Design lab preview only: sets <html data-lab> so components can style a variant. */
  lab?: string;
}

const { title, description = profile.headline, image = '/og.png', noindex = false, lab } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en" data-lab={lab}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === '/og.png' && <meta property="og:image:width" content="1200" />}
    {image === '/og.png' && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <script is:inline>
      // Design lab: ?lab=<id> previews a variant on any page (see src/data/lab-variants.ts)
      (() => {
        const lab = new URLSearchParams(location.search).get('lab');
        if (lab) document.documentElement.dataset.lab = lab;
      })();
    </script>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Fade elements in as they scroll into view. Re-runs after every
      // client-side navigation so it works with view transitions.
      function initReveal() {
        const items = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          items.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
